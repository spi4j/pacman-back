[module genCommon(	'http://www.obeonetwork.org/dsl/environment/3.0.0', 
					'http://www.obeonetwork.org/dsl/soa/4.0.0')/]
					
[import fr::pacman::back::core::aql::base/]	
[import fr::pacman::back::core::aql::name::classes/]
[import fr::pacman::back::core::aql::name::eobjects/]	
[import fr::pacman::back::core::aql::name::packages/]	
[import fr::pacman::back::core::aql::output::resources/]
[import fr::pacman::back::soa::spring::aql::block::test/]

[comment écriture du fichier d'implémentation pour le resolver junit (domain + infra)./]
[template public fileServiceOutResolverImpl(s : soa::Service)]
  [file (s.nameClassServiceOutResolverImpl().toFileJavaTest(s.namePackageCommonResolver()), overwrite, s.defaultFileEncoding())]
    [s.serviceOutResolverImpl()/]
  [/file]
[/template]

[comment écriture du fichier d'implémentation pour les test associés au service (domain)./]
[template public fileServiceTestImpl(s : soa::Service)]
  [file (s.nameClassServiceTestImpl().toFileJavaTest(s.namePackageServiceImpl()), overwrite, s.defaultFileEncoding())]
    [s.serviceTestImpl()/]
  [/file]
[/template]

[comment écriture du fichier de définition des données à injecter pour le service dans les tests fonctionnels (karate)./]
[template public fileServiceApiTestRunnerDefaultData(s : soa::Service)]
  [file (s.name().toFile(s.namePackageTestResources() + '/data', '.yaml'), overwrite, s.defaultFileEncoding())]
    [s.serviceApiTestRunnerDefaultData()/]
  [/file]
[/template]

[comment écriture du fichier de définition des scenarios pour le service dans les tests fonctionnels (karate)./]
[template public fileServiceApiTestRunnerDefaultGherkin(s : soa::Service)]
  [file (s.name().toFile(s.namePackageTestResources() + '/features','.feature'), overwrite, s.defaultFileEncoding())]
    [s.serviceApiTestRunnerDefaultGherkin()/]
  [/file]
[/template]

[comment écriture de l'implémentation pour le test du service (karate)./]
[template public fileServiceApiTestRunnerImpl(s : soa::Service)]
  [file (s.nameClassServiceTestImpl().toFileJavaTest(s.namePackageIntegrationTestImpl()), overwrite, s.defaultFileEncoding())]
    [s.serviceApiTestRunnerImpl()/]
  [/file]
[/template]

[comment écriture de l'implémentation pour le test du service (karate)./]
[template public fileServiceApiTestRunnerProviderImpl(s : soa::Service)]
  [file (s.nameClassServiceTestProviderImpl().toFileJavaTest(s.namePackageIntegrationTestImpl()), overwrite, s.defaultFileEncoding())]
    [s.serviceApiTestRunnerProviderImpl()/]
  [/file]
[/template]