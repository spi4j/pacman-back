[module service(	'http://www.obeonetwork.org/dsl/environment/3.0.0', 
					'http://www.obeonetwork.org/dsl/entity/3.0.0',
				    'http://www.obeonetwork.org/dsl/soa/4.0.0')/]

[import fr::pacman::back::core::aql::base/]
[import fr::pacman::back::core::aql::string/]			    
[import fr::pacman::back::core::aql::query::eobject/]
[import fr::pacman::back::core::aql::query::operation/]
[import fr::pacman::back::core::aql::output::resources/]

[import fr::pacman::back::core::property::project::ProjectProperties/]
[import fr::pacman::back::core::service::AnnotationUtils/]

[comment retourne tous les services 'provided' de l'application (on rajoute le fait qu'il soit un service rest)./]
[query public regularServices(m : soa::System) : Sequence(soa::Service) = m.eAllContents(soa::Service)
  ->select(o | o.kind = soa::InterfaceKind::provided and o.isRsService())/]

[comment retourne tous les services 'required' synchrones de l'application./]
[query public externalServices(m : soa::System) : Sequence(soa::Service) = m.eAllContents(soa::Service)
  ->select(o | o.kind = soa::InterfaceKind::required and o.synchronization = soa::SynchronizationKind::synchronous)/]
  
[comment retourne tous les services 'required' asynchrones de l'application./]
[query public batchServices(m : soa::System) : Sequence(soa::Service) = m.eAllContents(soa::Service)->select(o | o.isBatchService())/]

[comment retourne toutes les opérations d'un service soa./]
[query public operations(s : soa::Service) : Sequence(soa::Operation) = s.ownedInterface.ownedOperations/]

[comment retourne la liste des paramètres de type 'Entity' (sans doublon) pour toutes les opérations sur un service./]					
[query public outputEntities(s : soa::Service) : OrderedSet(entity::Entity) = s.ownedInterface.ownedOperations.output.type
  ->select(o | o.oclIsKindOf(entity::Entity))->asOrderedSet()/]

[comment retourne le(s) dto(s) associé(s) au service métier (pour l'instant ne devrait en avoir qu'un seul)./]  
[query public associatedDtos(s : soa::Service) : OrderedSet(environment::DTO) = s.eAllContents(soa::Parameter)
  ->select(o1 | o1.type.oclIsKindOf(environment::DTO))->collect(o2 | o2.type.oclAsType(environment::DTO))->asSet()/]

[comment vérifie si un service contient des opérations de type rest./]
[query private isRsService(s : soa::Service) : Boolean = s.exists() and not s.ownedInterface.ownedOperations
  ->select(o | o.exposition = soa::ExpositionKind::REST)->isEmpty() /]

[comment vérifie si le service utilise au moins une opération sécurisée./]
[query public isRsSecured(s : soa::Service) : Boolean = not s.ownedInterface.ownedOperations
  ->select(o | o.isRsSecured())->isEmpty()/]

[comment vérifie si le service est un service de persistance de type jpa (base de données)./]
[query public isJpaService(s : soa::Service) : Boolean = not s.is_metaS3Storage()/]

[comment vérifie si le service est un service de type stockage S3 (documents)./]
[query public isS3Service(s : soa::Service) : Boolean = s.is_metaS3Storage()/]

[comment vérifie si le service est un service asynchrone (batch)./]
[query public isBatchService(s : soa::Service) : Boolean = s.kind = soa::InterfaceKind::required 
  and s.synchronization = soa::SynchronizationKind::asynchronous/]

[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]  
[query public rsUri(s : soa::Service) : String = if (s.is_rsSSOAuthEnabled()) then s.rsUriMinArm() else s.rsUriStandard() endif /]
  
[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]  
[query public rsUri(m : soa::System) : String = if (m.is_rsSSOAuthEnabled()) then m.rsUriMinArm() else m.rsUriStandard() endif /]

[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]
[query private rsUriStandard(s : soa::Service) : String = if (s.isRsService()) then let c = s.eContainer().oclAsType(soa::Component) 
  in ('/' + c.URI +  '/' + s.cUriVersionPlaceholder() + '/' + s.URI).toUri().rsUriVersion(c) else s.cNoModelisation() endif/]
  
[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]
[query private rsUriStandard (m : soa::System) : String =  if (m.eAllContents(soa::Component)->size() = 1) then '/' + 
  let c = m.eAllContents(soa::Component)->first() in  (c.URI + '/' + m.cUriVersionPlaceholder()).toUri().rsUriVersion(c) 
  else m.cNoModelisation() endif/]
 
[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]
[query private rsUriMinArm(s : soa::Service) : String = if (s.isRsService()) then let c = s.eContainer().oclAsType(soa::Component) 
  in  ('/' + s.cUriVersionPlaceholder() + '/' + c.URI + '/' + s.URI).toUri().rsUriVersion(c) else s.cNoModelisation() endif/]  
[comment retourne l'uri (base) pour un service rest, si rien de renseigné, renvoie '/' par défaut./]
[query private rsUriMinArm (m : soa::System) : String =  if (m.eAllContents(soa::Component)->size() = 1) then '/' + m.cUriVersionPlaceholder() 
 + let c = m.eAllContents(soa::Component)->first() in ( + '/' + c.URI).toUri().rsUriVersion(c) else m.cNoModelisation() endif/]

[comment en dernier, remplace le placeholder par la version (permet ainsi que la version ne soit pas traitée par toUri())./]
[query private rsUriVersion(s : String, c : soa::Component) : String  = if (c.apiVersion.exists())  then s.replace(c.cUriVersionPlaceholder(), 
  c.apiVersion) else s.replace('/' + c.cUriVersionPlaceholder(), '') endif/]
