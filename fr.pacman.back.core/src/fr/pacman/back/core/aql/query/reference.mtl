[module reference(	'http://www.obeonetwork.org/dsl/environment/3.0.0', 
					'http://www.obeonetwork.org/dsl/entity/3.0.0',
					'http://www.obeonetwork.org/dsl/soa/4.0.0')/]

[import fr::pacman::back::core::aql::name::classes/]
[import fr::pacman::back::core::aql::query::property/]
[import fr::pacman::back::core::aql::query::eobject/]
[import fr::pacman::back::core::aql::name::eobjects/]
[import fr::pacman::back::core::service::AnnotationUtils/]	

[comment vérifie si la référence est de type récursif (0,1) (1)./]
[query public isZeroOneReflexive(r : environment::Reference) : Boolean = r.referencedType = r.containingType and not r.isMultiple()/]
  
[comment vérifie si un référence est de type recursif (0,*)(1,*)./]
[query public isStarReflexive(r : environment::Reference) : Boolean = r.referencedType = r.containingType and r.oppositeOf = null and r.isMultiple()/]

[comment vérifie si la référence est de type récursif (0,1)(1)(0,*)(1,*)./]
[query public isReflexive(r : environment::Reference) : Boolean = r.isZeroOneReflexive() or r.isStarReflexive()/]

[comment retourne l'entité référencée (pas toujours referencedType). Fait pour éviter la verbosité des références inverses./]
[query public referencedEntity(r : environment::Reference) : entity::Entity = r.referencedType.oclAsType(entity::Entity)/]

[comment retourne du dto référencé (pas toujours referencedType). Fait pour éviter la verbosité des références inverses./]	
[query public referencedDto(r : environment::Reference) : environment::DTO = r.referencedType.oclAsType(environment::DTO)/]
  
[comment raccourci pour l'obtention du 'containedType' dans le cadre d'une entité./][query public containingEntity(r : environment::Reference) : entity::Entity = r.containingType.oclAsType(entity::Entity)/]  
[comment raccourci pour l'obtention du 'containedType' dans le cadre d'une entité./][query public containingDto(r : environment::Reference) : environment::DTO = r.containingType.oclAsType(environment::DTO)/]

[comment vérifie si la relation est bidirectionnelle (normallement pas besoin de vérifier multiple) on interdit les bidirs non multiples./]
[comment bien notter que les reflexives (0,*) sont considérées et traitées comme des relations bidirectionnelles./]
[query public isBidirectionnal(r : environment::Reference) : Boolean = (r.oppositeOf <> null and r.isMultiple() and r.oppositeOf.isMultiple()) 
  or (r.isStarReflexive())/]

[comment vérifie si la référence a une stratégie de récupération paresseuse (LAZY)./]
[query public isLazyReference (r : environment::Reference) : Boolean = r.is_metaFetchLazy() or r.isBidirectionnal()/]
  
[comment vérifie si la référence exige une entité (entity/dto/xto) (les listes sont toujours considérées comme obligatoire)./]
[query public isMandatory(r : environment::Reference) : Boolean = r.multiplicity <> environment::MultiplicityKind::ZERO_ONE/]

[comment  vérifie si dans le cadre d'un xto on doit applatir la référence et ne renvoyer qu'un identifiant (seule méthode ou on doit comparer une égalité de structure)
          ATTENTION ici c'est containingType parcequ'on a inversé les éléments de la référence mais au niveau de la modélisation on agit bien sur referencedType). Par 
          ailleurs, dans le cas de l'héritage on ne peut pas faire (d = containing) car containing est anémique et ne sera jamais égal à d, il faut donc tester 
          l'égalité uniquement sur le nom ce qui n'est pas trop grave car containing a été positionné dans ReferenceUtils -> on est certain que le nom est bien 
          celui de containing initial./]
[query public hasToFlattenReference(r : environment::Reference, d : environment::DTO) : Boolean = not r.isBidirectionnal() and r.isMultiple() 
  and d.name.equalsIgnoreCase(r.containingType.name)/]

[comment vérifie si le type référencé implique que l'on doit prendre uniquement le nom de la référence (vérouillé pour l'instant)./]
[query private isReferenceName(r : environment::Reference, st : environment::StructuredType) : Boolean = false/]

[comment retourne le nom pour l'attribut en provenance de la référence (peut être obligé de préfixer avec le nom de l'attribut à cause de l'héritage)./]
[query public referencedName(e : entity::Entity, r : environment::Reference) : String = if(r.isReferenceName(e)) then r.name() else e.name() + '_' + r.name() endif/]

[comment retourne le nom pour l'attribut en provenance de la référence (pas de name pour StructuredType)./]
[query public referencedName(d : environment::DTO, r : environment::Reference) : String = if(r.isReferenceName(d)) then r.name() else d.name() + '_' + r.name() endif/]

[comment écriture du type complet pour les entités ou les dtos référencés (pas d'optional sinon plante jpa)./]
[query public referencedSignature(r : environment::Reference) : String =  if (r.isBidirectionnal()) then 'Set<' else '' endif 
  + if (r.referencedType.oclIsKindOf(entity::Entity)) then r.referencedEntity().nameClassEntityImpl() else r.referencedDto().nameClassDtoImpl() endif 
  + if (r.isBidirectionnal()) then '>' else '' endif /]
  
[comment écriture du type complet pour les xtos référencés./]
[query public referencedSignatureOut(r : environment::Reference) : String =  if (r.isBidirectionnal()) then 'Set<' else '' endif + r.referencedDto().nameClassXtoImpl() 
  + if (r.isBidirectionnal()) then '>' else '' endif /]

[comment écriture du type complet pour les entités ou les dtos référencés (pas d'optional sinon plante jpa) relation inverse pour bidirectionnel hibernate./]
[query public referencedSignatureInverse(r : environment::Reference) : String =  'List<' + if (r.containingType.oclIsKindOf(entity::Entity)) 
  then r.containingEntity().nameClassEntityImpl() else r.containingDto().nameClassDtoImpl() endif + '>'/]
  
[comment écriture du type complet pour xtos référencés  relation inverse pour bidirectionnel hibernate./]
[query public referencedSignatureOutInverse(r : environment::Reference) : String =  'List<' + r.containingDto().nameClassXtoImpl() + '>'/]
