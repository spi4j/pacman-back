[module validate(	'http://www.obeonetwork.org/dsl/entity/3.0.0', 
					'http://www.obeonetwork.org/dsl/soa/4.0.0', 
					'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::query::dto/]
[import fr::pacman::back::core::aql::validation::common/]
[import fr::pacman::back::core::validation::PacmanValidatorsReport/]
[import fr::pacman::back::core::property::project::ProjectProperties/]

[comment on fait déjà une passe pour les mots-clés java./]
[template public validateJKW(m : ecore::EObject)]
  
  [comment uniquement si la demande de validation est activée./]
  [if (m.is_validJKWEnabled())]
    [comment gestion des fichiers '.entity'./]
    [if (m.oclIsTypeOf(entity::Root))]
      [for (o | m.eAllContents(entity::Entity))]
        [comment pas d'entité avec un mot-clé java./]
        [if (o.name.isJavaKeyword())][o.add(o.errJ9())/][/if]
      [/for]
    [/if]
    
    [comment gestion des fichiers '.soa'./]
    [if (m.oclIsTypeOf(soa::System))]
      [for (o | m.eAllContents(environment::DTO))]
        [comment pas de dto avec un mot-clé java./]
        [if (o.name.isJavaKeyword())][o.add(o.errJ1())/][/if]
        [if (o.isPersistent())]
          [comment on vérifie aussi les attributs liés à l'entité associé./]
          [for (a | (o.associatedEntity().eAllContents(environment::Attribute)))]
            [if (a.name.isJavaKeyword())][a.add(a.errJ6())/][/if]
          [/for]
        [/if]
      [/for]
      [for (o | m.eAllContents(soa::Service))]
        [comment pas de service avec un mot-clé java./]
        [if (o.name.isJavaKeyword())][o.add(o.errJ3())/][/if]
      [/for]
      [for (o | m.eAllContents(soa::Parameter))]
        [comment pas de paramètre avec un mot-clé java./]
        [if (o.name.isJavaKeyword())][o.add(o.errJ4())/][/if]
      [/for]
      [for (o | m.eAllContents(soa::Operation))]
        [comment pas d'opération avec un mot-clé java./]
        [if (o.name.isJavaKeyword())][o.add(o.errJ5())/][/if]
      [/for]
    [/if]
    
    [comment gestion commune inter-fichiers./]
    [for (o | m.eAllContents(environment::Reference))]
      [comment pas de référence avec un mot-clé java./]
      [if (o.name.isJavaKeyword())][o.add(o.errJ2())/][/if]
    [/for]
    [for (o | m.eAllContents(environment::Attribute))]
      [comment pas d'attribut avec un mot-clé java./]
      [if (o.name.isJavaKeyword())][o.add(o.errJ6())/][/if]
    [/for]
    [for (o | m.eAllContents(environment::Literal))]
      [comment pas d'attribut d'énumération avec un mot-clé java./]
      [if (o.name.isJavaKeyword())][o.add(o.errJ7())/][/if]
    [/for]
    [for (o | m.eAllContents(environment::Enumeration))]
      [comment pas d'énumération avec un mot-clé java./]
      [if (o.name.isJavaKeyword())][o.add(o.errJ8())/][/if]
    [/for]
  [/if]
[/template]

[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ1 (o : environment::DTO) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom du dto'/]
  
[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ2 (o : environment::Reference) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de la référence'/]
  
[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ3 (o : soa::Service) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom du service'/]
  
[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ4 (o : soa::Parameter) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom du paramètre'/]
  
[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ5 (o : soa::Operation) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de l\'opération'/]

[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ6 (o : environment::Attribute) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de l\'attribut'/]

[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ7 (o : environment::Literal) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom du litéral'/]

[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ8 (o : environment::Enumeration) : String = 'RG_J01@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de l\'énumération'/]

[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public errJ9 (o : entity::Entity) : String = 'RG_J09@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de l\'entité'/]
  
[comment impossible de créer des éléments (objets) avec comme nom un mot-clé java./]
[query public err10 (o : ecore::EObject) : String = 'RG_J09@' + o.nameObject() + '@Présence de mot-clé java@Modifiez le nom de l\'entité'/]
