[module genServerSpring(	'http://www.obeonetwork.org/dsl/soa/4.0.0', 
                            'http://www.obeonetwork.org/dsl/environment/3.0.0') 
							extends fr::pacman::back::soa::aql::genServer/]

[comment toujours placer les 'main' au niveau des modules fils, sinon génération incomplète./]
[comment enlever ces imports suite a correction bug./]
[import fr::pacman::back::soa::aql::file::genServer/]
[import fr::pacman::back::core::aql::query::eobject/]
[comment enlever ces imports suite a correction bug./]

[import fr::pacman::back::soa::spring::aql::file::genServer/]
[import fr::pacman::back::core::aql::query::application/]
[import fr::pacman::back::core::aql::query::service/]
[import fr::pacman::back::core::aql::query::dto/]
[import fr::pacman::back::core::property::project::ProjectProperties/]

[comment @main/]
[template protected genServer(m : soa::System)]
  [m.super:genServer()/]
  [let ds = m.subTypesDtos()]
    [comment classe de définition pour openapi (swagger)./]
    [m.fileOpenApiConfigImpl()/]
    [comment classe de configuration pour les tests d'intégration/]
    [m.fileInIntegrationTestsConfigImpl()/]
    
    [comment implémentation de la configuration pour la sécurité rest./]
    [if (m.isRsSecured() and not m.is_rsSSOAuthEnabled())]
      [comment écrase et remplace le fichier généré par défaut./]
      [m.fileRsSecurityConfigImpl()/]
      [comment implémentation du service de création du jeton jwt./]
      [m.fileRsSecurityTokenServiceImpl()/]
      [comment implémentation du service d'authentification jwt./]
      [m.fileRsServiceTokenImpl()/]
    [/if]
    
    [comment implémentation de la configuration pour la sécurité rest./]
    [if (m.isRsSecured() and m.is_rsSSOAuthEnabled())]
      [comment écriture de la partie dynamique pour configuration sso (keycloack)./]
      [m.fileApplicationSSOProperties()/]
    [/if]
    
    [comment écriture de la couche de gestion pour le contrôle des violations de données./]
    [if (m.isRsIdorFullCtrlEnabled())]
      [comment écriture de la classe pour le contexte de controle des violations./]
      [m.fileRsDataIsolationContextImpl()/]
    [/if]
    
    [comment écriture d'un filtre pour la gestion générique des en-têtes./]
    [m.fileRsHeaderFilterImpl()/]
    
    [comment écriture pour les services sur couche de persistance./]
    [for (s : soa::Service | m.regularServices())]
      [let ads = s.associatedDtos()]
        [comment implémentation du service application (rest, etc..)./]
        [s.fileRsServiceImpl(ads)/]
        [comment implémentation du service infrastructure (persistance jpa)./]
        [if (s.isJpaService())][s.fileServiceOutJpaImpl(ads)/][/if]
        [comment implémentation du service infrastructure (persistance stockage s3)./]
        [if (s.isS3Service())][s.fileServiceOutS3Impl()/][/if]
        [comment implémentation des tests pour le contrôleur (application)./]
        [if (s.isJpaService())][s.fileInIntegrationTestImpl()/][/if]
      [/let]
    [/for]
    
    [comment écriture pour les services sur appel exterieur (circuit-breaker)./]
    [for (s : soa::Service | m.externalServices())]
      [s.fileServiceOutExtImpl(s.associatedDtos())/]
    [/for]
    
    [comment écriture des services sur traitements asynchrones (batchs)./]
    [for (s : soa::Service | m.batchServices())]
      [s.fileServiceOutBatchImpl(s.associatedDtos())/]
      [comment écriture de la configuration du job pour le service./]
      [s.fileServiceOutBatchConfigImpl()/]
      [comment écriture du tasklet pour le service./]
      [s.fileServiceOutBatchTaskletImpl()/]
      [comment écriture de l'orchestration pour le service./]
      [s.fileServiceOutBatchScheduleImpl()/]
    [/for]
    
    [comment implémentation du service crud infrastructure (persistance)./]
    [for (d : environment::DTO | ds)]
      [if (d.isPersistent())]
        [d.fileServiceCrudOutImpl(null)/]
      [/if]
    [/for]
  [/let]
[/template]