[module mapper(	'http://www.obeonetwork.org/dsl/soa/4.0.0', 
				'http://www.obeonetwork.org/dsl/entity/3.0.0',
				'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]
[import fr::pacman::back::core::aql::query::dto/]	
[import fr::pacman::back::core::aql::query::attribute/]				
[import fr::pacman::back::core::aql::name::classes/]
[import fr::pacman::back::core::aql::name::eobjects/]
[import fr::pacman::back::core::aql::name::packages/]
[import fr::pacman::back::core::aql::name::attributes/]
[import fr::pacman::back::core::aql::output::headers/]
[import fr::pacman::back::core::aql::output::resources/]
[import fr::pacman::back::core::aql::query::eobject/]
[import fr::pacman::back::core::aql::query::reference/]
[import fr::pacman::back::core::aql::query::property/]
[import fr::pacman::back::core::aql::rule::parameter/]
[import fr::pacman::back::core::aql::rule::variable/]
[import fr::pacman::back::core::aql::rule::common/]
[import fr::pacman::back::core::aql::rule::method/]
[import fr::pacman::back::core::service::AnnotationUtils/]	
[import fr::pacman::back::core::service::ReferenceUtils/]
	
[comment 	écriture de la classe utilitaire de mapping (anciennement matcher sous spi4j)
			pour la couche d'infrastructure. Les entités (ou dto) sont traitées avec le 
			wrapper 'Optional' si besoin, aucun contrôle n'est effectué au niveau des 
			types dits 'primitifs'./]

[comment : ENTITY <-> DTO./]			
[template public mapperOutImpl(d : environment::DTO)]
  [d.classHeader(d.namePackageMapperOutImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [d.defaultImports()/]
    import org.hibernate.Hibernate;
    import [d.namePackageProject()/].[d.namePackageDtoImpl()/].[d.nameClassDtoImpl()/];
    import [d.namePackageProject()/].[d.associatedEntity().namePackageEntityImpl()/].[d.associatedEntity().nameClassEntityImpl()/];
    
  [/protected]
  
  /**
   * Classe utilitaire pour la conversion entre les objets {@link [d.nameClassDtoImpl()/]} et {@link [d.associatedEntity().nameClassEntityImpl()/]}.  
   * Cette classe fournit deux méthodes statiques pour convertir un objet DTO en une entité et inversement.
   * Elle permet de mapper un objet {@link [d.nameClassDtoImpl()/]} vers un {@link [d.associatedEntity().nameClassEntityImpl()/]} et vice-versa.  
   */
  public class [d.nameClassMapperImpl()/]
  {
  
    [let rus = d.get_unidirectionnals()]
    [let ris = d.get_unidirectionnalsInverse()]
    [let rbs = d.get_bidirectionnals()]
    [let e = d.associatedEntity()]
    [let rs = rus->union(rbs)]
       /**
       * Cette méthode permet de convertir un objet {@link [d.nameClassDtoImpl()/]} en une entité {@link [d.associatedEntity().nameClassEntityImpl()/]}.
       * 
       * @param [d.suffixDto().apply_parameterMethodClassicIn()/] L'objet de type {@link [d.nameClassDtoImpl()/]} à convertir. Il ne doit pas être nul.
       * @return Un objet de type {@link [d.associatedEntity().nameClassEntityImpl()/]} représentant l'entité correspondante.
       * 
       * @throws [d.nameClassMapperExceptionImpl()/] Si le paramètre dto est nul, une exception est lancée pour signaler l'impossibilité de réaliser la conversion.
       */
       public static [d.associatedEntity().nameClassEntityImpl()/] [('to ' + d.suffixEntity()).apply_methodDefault()/] 
         (final [d.nameClassDtoImpl()/] [d.suffixDto().apply_parameterMethodClassicIn()/])
       { 
          if(null == [d.suffixDto().apply_parameterMethodClassicIn()/])
          {
             return null;
          }
          
          [e.nameClassEntityImpl()/] [d.suffixEntity().apply_variableDefault()/] = new [e.nameClassEntityImpl()/]();
          
          try {
              [e.suffixEntity()/].[e.nameSimplePropertyID().apply_methodSet()/]([d.suffixDto()/].[e.nameSimplePropertyID().apply_methodGet()/]());
              [for (a : environment::Attribute | d.attributesNoPKAndNoComputed())]
                [d.writeAttributeOutEntityMapper(a)/]
              [/for]
              [for (r | rs)]
                [comment uniquement sur références communes dto-entity./]
                [if (d.hasAssociatedEntityReference(r))]
                  [r.writeOutEntityReferenceMapper(d)/]
                [/if]
              [/for]
              [comment gestion de références inverses./]
              [for (r | ris)]
                [comment uniquement sur références communes dto-entity./]
                [if (d.hasAssociatedEntityReference(r))]
                  [r.writeInverseReferenceOutEntityMapper(d)/]
                [/if]
              [/for]
              [for (prop : String | d.autoAttributes())]
                [comment les champs automatiques de persistance sont créés au dernier momment./]
                [comment d.writeAutoAttributeOutEntity(prop)/]
              [/for]
              
              [protected ((e.nameClassEntityImpl() ' in').protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
              [/protected]
               
          } catch (Exception e) {
             throw new [d.nameClassMapperExceptionImpl()/]("Impossible de mapper la classe : [d.associatedEntity().nameClassEntityImpl()/]");
          }
          return [d.suffixEntity().apply_variableDefault()/];
       }
       
       /**
       * Cette méthode permet de convertir un objet {@link [d.associatedEntity().nameClassEntityImpl()/]} en un {@link [d.nameClassDtoImpl()/]}.
       * 
       * @param entity L'objet de type {@link [d.associatedEntity().nameClassEntityImpl()/]} à convertir. Il ne doit pas être nul.
       * @return Un objet de type {@link [d.nameClassDtoImpl()/]} représentant le DTO correspondant.
       * 
       * @throws [d.nameClassMapperExceptionImpl()/] Si le paramètre entity est nul, une exception est lancée pour signaler l'impossibilité de réaliser la conversion.
       */
       public static [d.nameClassDtoImpl()/] [('to ' + d.suffixDto()).apply_methodDefault()/] 
           (final [d.associatedEntity().nameClassEntityImpl()/] [d.suffixEntity().apply_parameterMethodClassicIn()/])
       {
           if(null ==[d.suffixEntity().apply_parameterMethodClassicIn()/])
           {
             return null;
           }
           
           [d.nameClassDtoImpl()/] [d.suffixDto()/] = new [d.nameClassDtoImpl()/]();
           
           try {
               [d.suffixDto()/].[e.nameSimplePropertyID().apply_methodSet()/]([d.suffixEntity()/].[e.nameSimplePropertyID().apply_methodGet()/]());
               [for (a : environment::Attribute | d.attributesNoPKAndNoComputed())]
               [d.writeAttributeOutDtoMapper(a, false)/]
               [/for]
               [for (r | rs)]
                 [comment uniquement sur références communes dto-entity./]
                 [if (d.hasAssociatedEntityReference(r))]
                   [r.writeOutDtoReferenceMapper(d, false)/]
                 [/if]
               [/for]
               [comment gestion de références inverses./]
               [for (r | ris)]
                 [comment uniquement sur références communes dto-entity./]
                 [if (d.hasAssociatedEntityReference(r))]
                   [r.writeInverseReferenceOutDtoMapper(d)/]
                 [/if]
               [/for]
               [for (prop : String | d.autoAttributes())]
                 [d.writeAutoAttributeOutDto(prop)/]
               [/for]
               
               [protected ((d.nameClassDtoImpl() + ' in').protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
                 [comment uniquement sur attributs calculés dto, libre au développeur de rajouter le code 
                           nécessaire pour initialiser sa propriété./]
                 [for (a : environment::Attribute | d.attributesComputed())]
                   [d.writeAttributeOutDtoMapper(a, true)/]
                 [/for]
                 [comment uniquement sur références supplémentaires dto.] 
                 [comment libre au développeur de rajouter le code nécessaire pour initialiser sa propriété./]
                 [for (r | rs)]
                   [if (not d.hasAssociatedEntityReference(r))]
                     [r.writeOutDtoReferenceMapper(d, true)/]
                   [/if]
                 [/for]
               [/protected]
               
           } catch (Exception e) {
               throw new [d.nameClassMapperExceptionImpl()/]("Impossible de mapper la classe : [d.nameClassDtoImpl()/]");
           }
           return [d.suffixDto()/];
       }
    [/let][/let]
    [/let][/let]
    [/let]
  }
[/template]

[comment : XTO <-> DTO./]	
[template public mapperInImpl(d : environment::DTO)]
  [d.classHeader(d.namePackageMapperInImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [d.defaultImports()/]
    import [d.namePackageProject()/].[d.namePackageXtoImpl()/].[d.nameClassXtoImpl()/];
    import [d.namePackageProject()/].[d.namePackageDtoImpl()/].[d.nameClassDtoImpl()/];
    
  [/protected]
  
  /**
   * La classe {@code [d.nameClassMapperImpl()/]} est responsable de la conversion entre deux types d'objets : 
   * {@link [d.nameClassXtoImpl()/]} et {@link [d.nameClassDtoImpl()/]}. Elle fournit des méthodes statiques pour effectuer 
   * ces transformations. Si une conversion échoue (en raison d'un paramètre {@code null}), une exception
   * {@link [d.nameClassMapperExceptionImpl()/]} est lancée.
   */
  public class [d.nameClassMapperImpl()/]
  {
    
    [let rus = d.get_unidirectionnals()]
    [let ris = d.get_unidirectionnalsInverse()]
    [let rbs = d.get_bidirectionnals()]
    [let e = d.associatedEntity()]
    [let rs = rus->union(rbs)]
      /**
       * Convertit un objet {@link [d.nameClassXtoImpl()/]} en un objet {@link [d.nameClassDtoImpl()/]}.
       * Si l'objet {@code [d.nameClassXtoImpl()/]} est {@code null}, une {@link [d.nameClassMapperExceptionImpl()/]} est lancée.
       *
       * @param [d.suffixXto().apply_parameterMethodClassicIn()/] L'objet {@code [d.nameClassXtoImpl()/]} à convertir.
       * @return Un objet {@code [d.nameClassDtoImpl()/]} représentant les mêmes informations que {@code [d.nameClassXtoImpl()/]}.
       * @throws [d.nameClassMapperExceptionImpl()/] Si l'objet {@code [d.nameClassXtoImpl()/]} est {@code null}.
       */
      public static [d.nameClassDtoImpl()/] [('to ' + d.suffixDto()).apply_methodDefault()/] 
        (final [d.nameClassXtoImpl()/] [d.suffixXto().apply_parameterMethodClassicIn()/])
      { 
      
         if(null == [d.suffixXto().apply_parameterMethodClassicIn()/])
         {
            return null;
         }
         
         [d.nameClassDtoImpl()/] [d.suffixDto().apply_variableDefault()/] = new [d.nameClassDtoImpl()/]();
             
             try {
             
               [d.suffixDto()/].[e.nameSimplePropertyID().apply_methodSet()/]([d.suffixXto()/].[e.nameSimplePropertyID().apply_methodGet()/]());
               [for (a : environment::Attribute | d.attributesNoPKAndNoComputed())]
                 [d.writeAttributeInDtoMapper(a)/]
               [/for]
               [for (r | rs)]
                 [r.writeInDtoReferenceMapper(d)/]
               [/for]
               [for (r | ris)]
                 [r.writeInverseReferenceInDtoMapper(d)/]
               [/for]
               [for (prop : String | d.autoAttributes())]
                 [d.writeAutoAttributeInDto(prop)/]
               [/for]
               
               [protected ((d.nameClassDtoImpl() + ' out').protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
               [/protected]
               
             } catch (Exception e) {
               throw new [d.nameClassMapperExceptionImpl()/]("Impossible de mapper la classe : [d.nameClassDtoImpl()/]");
             }
         
           return [d.suffixDto().apply_variableDefault()/];
       
         }
         
         /**
         * Convertit un objet {@link [d.nameClassDtoImpl()/]} en un objet {@link [d.nameClassXtoImpl()/]}.
         * Si l'objet {@code [d.nameClassDtoImpl()/]} est {@code null}, une {@link [d.nameClassMapperExceptionImpl()/]} est lancée.
         *
         * @param [d.suffixDto().apply_parameterMethodClassicIn()/] L'objet {@code [d.nameClassDtoImpl()/]} à convertir.
         * @return Un objet {@code [d.nameClassXtoImpl()/]} représentant les mêmes informations que {@code [d.nameClassDtoImpl()/]}.
         * @throws [d.nameClassMapperExceptionImpl()/] Si l'objet {@code [d.nameClassDtoImpl()/]} est {@code null}.
         */
         public static [d.nameClassXtoImpl()/] [('to ' + d.suffixXto()).apply_methodDefault()/] (final [d.nameClassDtoImpl()/] [d.suffixDto().apply_parameterMethodClassicIn()/])
         { 
          
           if(null == [d.suffixDto().apply_parameterMethodClassicIn().apply_parameterMethodClassicIn()/])
           {
             return null;
           }
           
           [d.nameClassXtoImpl()/] [d.suffixXto().apply_variableDefault()/] = new [d.nameClassXtoImpl()/]();
            
           try {
               
               [d.suffixXto()/].[e.nameSimplePropertyID().apply_methodSet()/]([d.suffixDto()/].[e.nameSimplePropertyID().apply_methodGet()/]());
               [for (a : environment::Attribute | d.attributesNoPKAndNoComputed())]
                 [d.writeAttributeInXtoMapper(a)/]
               [/for]
               [for (r | rs)]
                 [r.writeInXtoReferenceMapper(d)/]
               [/for]
               [for (r | ris)]
                  [r.writeInverseReferenceInXtoMapper(d)/]
               [/for]
               [for (prop : String | d.autoAttributes())]
                 [d.writeAutoAttributeInXto(prop)/]
               [/for]
               
               [protected ((d.nameClassXtoImpl() + ' out').protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
               [/protected]
               
           } catch (Exception e) {
               throw new [d.nameClassMapperExceptionImpl()/]("Impossible de mapper la classe : [d.nameClassXtoImpl()/]");
           }
           return [d.suffixXto().apply_variableDefault()/];
      }	 
    [/let][/let]
    [/let][/let]
    [/let]
  }
[/template]

[comment ******************************************************************************************************************************************./]
[comment ne jamais utiliser les méthodes associatesEntity, etc... à partir de cette partie, on travaille sur les références avec un modèle anémique./]
[comment ******************************************************************************************************************************************./]

[comment écriture pour la partie spécifique de la gestion des références./]
[query private writeOutEntityReferenceMapper(r : environment::Reference, d : environment::DTO) : String = if (r.isBidirectionnal()) then 
  r.writeListOutEntityMapper(d) else r.writeReferenceOutEntityMapper(d) endif/]
  
[comment écriture pour la partie spécifique de la gestion des références (positionner à null si b = 'true')./]
[query private writeOutDtoReferenceMapper(r : environment::Reference, d : environment::DTO, b : Boolean) : String = if (r.isBidirectionnal()) then 
  r.writeListOutDtoMapper(d) else r.writeReferenceOutDtoMapper(d, b) endif/]

[comment écriture pour la partie spécifique de la gestion des références./]
[query private writeInDtoReferenceMapper(r : environment::Reference, d : environment::DTO) : String =  if (r.isBidirectionnal()) then 
  r.writeListInDtoMapper(d) else  if (r.hasToFlattenReference(d)) then r.writeAttributFlattenInDtoMapper(d) else r.writeReferenceInDtoMapper(d) endif endif/]

[comment écriture pour la partie spécifique de la gestion des références./]
[query private writeInXtoReferenceMapper(r : environment::Reference, d : environment::DTO) : String = if (r.isBidirectionnal())then r.writeListInXtoMapper(d) 
  else if (r.hasToFlattenReference(d)) then r.writeAttributeFlattenInXtoMapper(d) else r.writeReferenceInXtoMapper(d) endif endif/]

[comment écriture d'une ligne de mapping pour un attribut automatique./]
[query private writeAutoAttributeOutEntity(d : environment::DTO, prop : String) : String = d.suffixEntity().apply_variableDefault() 
  + '.' + prop.nameAutoAttribute().apply_methodSet() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + prop.nameAutoAttribute().apply_methodGet() + '());'/]
  
[comment écriture d'une ligne de mapping pour un attribut automatique./]
[query private writeAutoAttributeOutDto(d : environment::DTO, prop : String) : String =  d.suffixDto().apply_variableDefault() 
  + '.' + prop.nameAutoAttribute().apply_methodSet() + '(' + d.suffixEntity().apply_parameterMethodClassicIn() + '.' 
  + prop.nameAutoAttribute().apply_methodGet() + '());'/]  
[comment écriture d'une ligne de mapping pour un attribut automatique (pour l'instant les attributs automatiques ne sont pas copiés)./]
[query private writeAutoAttributeInDto(d : environment::DTO, prop : String) : String = ''/]  
[comment écriture d'une ligne de mapping pour un attribut automatique (pour l'instant les attributs automatiques ne sont pas copiés)./]
[query private writeAutoAttributeInXto(d : environment::DTO, prop : String) : String =  ''/]
  
[comment écriture de la ligne pour applatir (flatten) une référence au niveau du dto./]
[query private writeAttributFlattenInDtoMapper (r : environment::Reference, d : environment::DTO) : String = let rd = r.referencedDto().referencedName(r) 
  in  r.referencedDto().nameClassDtoImpl() + ' ' + rd.apply_variableDefault() + ' = new ' + r.referencedDto().nameClassDtoImpl() + '();' + r.lineSeparator() 
  + rd.apply_variableDefault() + '.' + r.referencedDto().nameSimplePropertyID().apply_methodSet() + '(' + r.suffixDto() + '.' 
  + rd.apply_methodGet() + '().' + r.referencedDto().nameSimplePropertyID().apply_methodGet()
  + '());' + d.lineSeparator() + d.suffixDto() + '.' + rd.apply_methodSet() + '(' + rd.apply_variableDefault() + ');' /]
  
[comment écriture de la ligne pour applatir (flatten) une référence au niveau du xto./]
[query private writeAttributeFlattenInXtoMapper (r : environment::Reference, d :environment::DTO) : String = d.suffixXto().apply_variableDefault() 
 + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + d.suffixDto() + '.' + r.referencedDto().referencedName(r).apply_methodGet() 
 + '().' + r.referencedDto().nameSimplePropertyID().apply_methodGet() +'());'/]  
[comment écriture d'une ligne de mapping pour un attribut standard./]
[query private writeAttributeInXtoMapper(d : environment::DTO, a : environment::Attribute) : String = d.suffixXto().apply_variableDefault() 
  + '.' + a.name().apply_methodSet() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' + a.name().apply_methodGet() + '());'/]
  
[comment écriture d'une ligne de mapping pour un attribut standard./]
[query private writeAttributeInDtoMapper(d : environment::DTO, a : environment::Attribute) : String = d.suffixDto().apply_variableDefault() 
  + '.' + a.name().apply_methodSet() + '(' + d.suffixXto().apply_parameterMethodClassicIn() + '.' + a.name().apply_methodGet() + '());'/]

[comment écriture d'une ligne de mapping pour un attribut Attribute (pour l'instant jamais null, à voir en fonction réponse vincent)./]
[query private writeAttributeOutDtoMapper(d : environment::DTO, a : environment::Attribute, bComputed : Boolean) : String =  d.suffixDto().apply_variableDefault() 
  + '.' + a.name().apply_methodSet() + '(' + if (bComputed) then 'null' else d.suffixEntity().apply_parameterMethodClassicIn() + '.' 
  + a.name().apply_methodGet() + '()' endif + ');' + if (bComputed) then '// TODO Champ calculé à initialiser.' else '' endif/]
  
[comment écriture d'une ligne de mapping pour un attribut standard./]
[query private writeAttributeOutEntityMapper(d : environment::DTO, a : environment::Attribute) : String = d.suffixEntity().apply_variableDefault() 
  + '.' + a.name().apply_methodSet() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' + a.name().apply_methodGet() + '());'/]

[comment écriture de mapping pour une liste dans le cadre d'une référence./]
[query private writeListOutDtoMapper(r : environment::Reference, d : environment::DTO) : String = d.suffixDto().apply_variableDefault() 
  + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + if (r.is_metaFetchLazy()) then 'Hibernate.isInitialized(' 
  + d.suffixEntity().apply_parameterMethodClassicIn() + '.' + r.referencedDto().referencedName(r).apply_methodGet() + '())?' else '' endif 
  + d.suffixEntity().apply_parameterMethodClassicIn() + '.' + r.referencedDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' 
  + r.referencedDto().nameClassMapperImpl() + '.' + ('to ' + d.suffixDto()).apply_methodDefault() + '(o)).collect(Collectors.' 
  + if (r.isBidirectionnal()) then 'toSet' else 'toList' endif + '())' + if (r.is_metaFetchLazy()) then ': new ' 
  + if (r.isBidirectionnal()) then 'HashSet' else 'ArrayList' endif  + '<' + r.referencedDto().nameClassDtoImpl() 
  + '>' +  '()'else '' endif + ');'/]

[comment écriture de mapping pour une liste dans le cadre d'une référence./]
[query private writeListOutEntityMapper(r : environment::Reference, d : environment::DTO) : String = d.suffixEntity().apply_variableDefault() 
  + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.referencedDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixEntity()).apply_methodDefault() + '(o)).collect(Collectors.' +  if (r.isBidirectionnal()) 
  then 'toSet' else 'toList' endif + '()));'/]

[comment écriture de mapping pour une liste dans le cadre d'une référence./]
[query private writeListInDtoMapper(r : environment::Reference, d : environment::DTO) : String = d.suffixDto().apply_variableDefault() 
  + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + d.suffixXto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.referencedDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixDto()).apply_methodDefault() + '(o)).collect(Collectors.' +  if (r.isBidirectionnal()) 
  then 'toSet' else 'toList' endif + '()));'/]

[comment écriture de mapping pour une liste dans le cadre d'une référence./]
[query private writeListInXtoMapper(r : environment::Reference, d : environment::DTO) : String = d.suffixXto().apply_variableDefault() 
  + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.referencedDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixXto()).apply_methodDefault() + '(o)).collect(Collectors.' +  if (r.isBidirectionnal()) 
  then 'toSet' else 'toList' endif + '()));'/]

[comment écriture de mapping pour une liste dans le cadre d'une référence inverse./]
[query private writeInverseReferenceInXtoMapper(r : environment::Reference, d : environment::DTO) : String  = d.suffixXto().apply_variableDefault() 
  + '.' + r.containingDto().referencedName(r).apply_methodSet() + '('+ d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.containingDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.containingDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixXto()).apply_methodDefault() + '(o)).collect(Collectors.' +  'toList()));' /]
  
[comment écriture de mapping pour une liste dans le cadre d'une référence inverse./]
[query private writeInverseReferenceInDtoMapper(r : environment::Reference, d : environment::DTO) : String  = d.suffixDto().apply_variableDefault() 
  + '.' + r.containingDto().referencedName(r).apply_methodSet() + '('+ d.suffixXto().apply_parameterMethodClassicIn() + '.' 
  + r.containingDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.containingDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixDto()).apply_methodDefault() + '(o)).collect(Collectors.' +  'toList()));' /]
    
[comment écriture de mapping pour une liste dans le cadre d'une référence inverse./]
[query private writeInverseReferenceOutDtoMapper(r : environment::Reference, d : environment::DTO) : String  = d.suffixDto().apply_variableDefault() 
  + '.' + r.containingDto().referencedName(r).apply_methodSet() + '('+ d.suffixEntity().apply_parameterMethodClassicIn() + '.' 
  + r.containingDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.containingDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixDto()).apply_methodDefault() + '(o)).collect(Collectors.' +  'toList()));' /]

[comment écriture de mapping pour une liste dans le cadre d'une référence inverse./]
[query private writeInverseReferenceOutEntityMapper (r : environment::Reference, d : environment::DTO) : String  = d.suffixEntity().apply_variableDefault() 
  + '.' + r.containingDto().referencedName(r).apply_methodSet() + '('+ d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.containingDto().referencedName(r).apply_methodGet() + '().stream().map(o -> ' + r.containingDto().nameClassMapperImpl() + '.' 
  + ('to ' + d.suffixEntity()).apply_methodDefault() + '(o)).collect(Collectors.' +  'toList()));' /]
  
[comment écriture de la ligne de mapping pour une référence optionnelle ou non (hors liste)./]
[query private writeReferenceInXtoMapper(r : environment::Reference, d : environment::DTO) : String  = 
  d.suffixXto().apply_variableDefault() + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + r.referencedDto().nameClassMapperImpl() 
  + '.' + ('to ' + d.suffixXto()).apply_methodDefault() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '()));'/]
  
[comment écriture de la ligne de mapping pour une référence optionnelle ou non (hors liste)./]
[query private writeReferenceInDtoMapper(r : environment::Reference, d : environment::DTO) : String  = 
  d.suffixDto().apply_variableDefault() + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + r.referencedDto().nameClassMapperImpl() 
  + '.' + ('to ' + d.suffixDto()).apply_methodDefault() + '(' + d.suffixXto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '()));' /]
  
[comment écriture de la ligne de mapping pour une référence optionnelle ou non (hors liste)./]
[query private writeReferenceOutDtoMapper(r : environment::Reference, d : environment::DTO, b : Boolean) : String  = 
  d.suffixDto().apply_variableDefault() + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + r.referencedDto().nameClassMapperImpl() 
  + '.' + ('to ' + d.suffixDto()).apply_methodDefault() + '(' + if (b) then 'null' else d.suffixEntity().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '()' endif + '));' + if (b) then '// TODO Champ calculé à initialiser.' else '' endif/]
  
[comment écriture de la ligne de mapping pour une référence optionnelle ou non (hors liste)./]
[query private writeReferenceOutEntityMapper(r : environment::Reference, d : environment::DTO) : String  =
  d.suffixEntity().apply_variableDefault() + '.' + r.referencedDto().referencedName(r).apply_methodSet() + '(' + r.referencedDto().nameClassMapperImpl() 
  + '.' + ('to ' + d.suffixEntity()).apply_methodDefault() + '(' + d.suffixDto().apply_parameterMethodClassicIn() + '.' 
  + r.referencedDto().referencedName(r).apply_methodGet() + '()));' /]
  
[comment ./]
[query private dsq1(d : environment::DTO) : String = d.attributesNoPKAndNoComputed()->collect(o | 'entity'.apply_parameterMethodClassicIn() 
  + '.' + o.nameAttribute().apply_methodGet() + '()'  + o.lineSeparator())->sep(',')->toString()/]

[comment ./]
[query private dsq2(d : environment::DTO) : String = d.attributesNoPKAndNoComputed()->collect(o | 'xto'.apply_parameterMethodClassicIn() 
  + '.' + o.nameAttribute().apply_methodGet() + '()'  + o.lineSeparator())->sep(',')->toString()/]
