[comment écriture de l'implémentation pour le stub associé au service (domain + infra)./]
[template public serviceOutStubImpl(s : soa::Service)]
  [s.classHeader(s.namePackageOutStubImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [s.defaultImports()/]
    import [s.namePackageProject()/].[s.namePackageCommonBase()/].[s.nameClassAnnotationStubOut()/];
    import [s.namePackageProject()/].[s.namePackageCommonException()/].[s.nameClassNotImplementedExceptionImpl()/];
    import [s.namePackageProject()/].[s.namePackageOutItf()/].[s.nameClassServiceOutItf()/];
    
  [/protected]
  
  /**
   * Implémentation de service stub pour le service [s.name()/]. Cette classe
   * implémente l'interface {@link [s.nameClassServiceOutItf()/]} et fournit une version
   * de base des opérations liées à la gestion des personnes. Elle sert de point
   * de départ pour des implémentations réelles ou de tests.
   * <p>
   * Cette classe est un stub, ce qui signifie qu'elle peut contenir des
   * implémentations vides ou des comportements par défaut pour les méthodes de
   * l'interface {@link [s.nameClassServiceOutItf()/]}.
   *
   * Positionner ici l'ensemble du code nécessaire pour remplacer les appels à la
   * couche de persistance. Cette classe peut être utilisée à la fois dans le
   * cadre des tests métier et dans le cadre des tests d'intégration.
   * @author [s.nameAuthor()/]  
   */
  @[s.nameClassAnnotationStubOut()/]
  public class [s.nameClassServiceOutStubImpl()/]  implements [s.nameClassServiceOutItf()/]
  {
  
    [for (o : soa::Operation | s.ownedInterface.ownedOperations)]
      [o.commentOperation()/]
      @Override
      public [o.outputType()/] [o.nameOperation()/] ([o.inputSignature()/])
      {
        
        [protected (o.name().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
          
          throw new [s.nameClassNotImplementedExceptionImpl()/]
             ("Le test n'a pas été implémenté pour le stub : [s.nameClassServiceImpl()/]");
          
        [/protected]
      }
         
      [/for]
      
      [protected ('custom operations'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
      [/protected]
  }
  
[/template]

[comment écriture de l'implémentation pour le test du service (karate)./]
[template public serviceApiTestRunnerProviderImpl (s : soa::Service)]
  [s.classHeader(s.namePackageIntegrationTestImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [s.defaultImports()/]
    import [s.namePackageProject()/].[s.namePackageOutItf()/].[s.nameClassServiceOutItf()/];
    
  [/protected]
  
  /**
  * Fournisseur de données dédié aux tests du service : [s.nameClassServiceImpl()/]. 
  * Il implémente le port {@link [s.nameClassServiceOutItf()/]} afin de simuler l'accès aux données sans
  * recourir à une source de données réelle. Les données doivent être
  * implémentées à partir du contenu du fichier JSON utilisé par les scénarios
  * Karate, tout en faisant correspondre chaque opération du fournisseur aux données
  * d'entrée et aux résultats attendus.
  * 
  * Cette implémentation assure ainsi le lien entre le jeu de données JSON et les
  * opérations sollicitées par le service métier lors des tests.
  * 
  * @author [s.nameAuthor()/]
  */
  class [s.nameClassServiceTestProviderImpl()/] implements [s.nameClassServiceOutItf()/] {
    
    /**
     * Données de test issues du fichier [s.name()/].yaml.
     */
    @SuppressWarnings("unused")
    private Map<String, Object> ['data'.apply_attributeDefault()/];
    
    /**
     * Définit les données de test utilisables par le fournisseur.
     *
     * @param ['data'.apply_parameterMethodClassicIn()/] map contenant les données chargées depuis le fichier YAML
     */
    void ['data'.apply_methodSet()/] (final Map<String, Object> ['data'.apply_parameterMethodClassicIn()/]) {
       [s.prefixAffectation()/]['data'.apply_attributeDefault()/] = ['data'.apply_parameterMethodClassicIn()/];
    }
    
    [for (o | s.ownedInterface.ownedOperations->select(o1 | o1.isRsOperation())) separator('\n')]
       [o.commentOperation()/]
       @Override
       [o.writePersistSignature()/] {
           
           // Insérez ici le code nécessaire pour charger les données depuis la rubrique
           // "[o.name()/]" du fichier [s.name()/].yaml et/ou compléter l'objet selon
           // le rôle de l'opération dans le service métier.
           
          [protected (o.name().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
            
            return null;
            
          [/protected]
       }
    [/for]
  }
[/template]

[comment écriture du fichier de définition des scenarios pour le service dans les tests fonctionnels (karate/domain)./]
[template public serviceApiTestRunnerDefaultGherkin (s : soa::Service)]
  
  Feature: Service [s.name()/]
      
    [for (o | s.ownedInterface.ownedOperations->select(o1 | o1.isRsOperation())) separator('\n')]
      @[o.name()/]
      Scenario: [o.name()/]
        * print '--- Service métier : [o.name()/] ---'
        
        # Chargement des données d'entrée
        * def externalData = karate.properties['['/]'test.data.dir'[']'/]
        * def dataFileName = '[s.name()/].yaml'
        * def dataFile = externalData ? 'file:' + externalData + '/' + dataFileName : 'classpath:data/' + dataFileName
        * def data = read(dataFile)
        
        # Initialisation du service métier
        * def Test = Java.type('[s.namePackageProject()/].[s.namePackageIntegrationTestImpl()/].[s.nameClassServiceTestImpl()/]')
        * def test = new Test()
        
        # Exécution du service métier
        * def result = test.[o.name()/](data.[o.name()/])
        
        # Vérification du résultat
        * match result != null
        # TODO : compléter les assertions selon le comportement attendu
        [protected (o.name().protectedId()) startTagPrefix('# ') endTagPrefix('# ')]
          
        [/protected]
        
    [/for]
      
[/template]

[comment écriture de l'implémentation pour le test du service (karate)./]
[template public serviceApiTestRunnerImpl (s : soa::Service)]
  [s.classHeader(s.namePackageIntegrationTestImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [s.defaultImports()/]
    import [s.namePackageProject()/].[s.namePackageOutItf()/].[s.nameClassServiceOutItf()/];
    import [s.namePackageProject()/].[s.namePackageServiceImpl()/].[s.nameClassServiceImpl()/];
    
  [/protected]
  
  /**
  * Adaptateur de test permettant d'exécuter les opérations du service métier
  * {@link [s.nameClassServiceImpl()/]} dans les scénarios Karate.
  *
  * Pour récupérer une valeur issue des données YAML transmises dans la map
  * {@code data}, utiliser la clé correspondant au nom de l'attribut défini dans
  * le fichier YAML et effectuer une conversion vers le type Java attendu.
  * 
  * Exemple pour renseigner le nom d'une personne : personne.setNom((String)
  * data.get("nom"));
  * 
  * Pour les valeurs numériques, utiliser si nécessaire {@code Number}, pour
  * convertir la valeur vers le type attendu, par exemple : personne.setAge
  * ((Number) data.get("age")).integerValue() );
  * 
  * Les clés utilisées dans {@code data.get(...)} doivent correspondre exactement
  * à celles définies dans le fichier YAML.
  *
  * @author [s.nameAuthor()/]
  */
  public class [s.nameClassServiceTestImpl()/] {
    
    /**
     * Service métier utilisé pour exécuter les opérations.
     */
    private final [s.nameClassServiceImpl()/] ['service'.apply_attributeFinal()/];
    
    /**
     * Fournisseur de données utilisé par le service métier dans le cadre des tests
     * fonctionnels.
     */
    private final [s.nameClassServiceTestProviderImpl()/] ['provider'.apply_attributeFinal()/];
    
    /**
    * Initialise l'adaptateur pour le service métier.
    */
    public [s.nameClassServiceTestImpl()/]() {
       [s.prefixAffectation()/]['provider'.apply_variableDefault()/] 
         = new [s.nameClassServiceTestProviderImpl()/]();
       [s.prefixAffectation()/]['service'.apply_attributeFinal()/] 
         = new [s.nameClassServiceImpl()/](['provider'.apply_variableDefault()/]);
    }
    
    [for (o | s.ownedInterface.ownedOperations->select(o1 | o1.isRsOperation())) separator('\n')]
       [o.commentOperation()/]
       public [o.outputType()/] [o.name()/](final Map<String, Object> ['data'.apply_parameterMethodClassicIn()/]) {
       
         [for (p | o.input)]
           [p.type.type()/] [p.name()/] = null;
         [/for]
         
         // Insérez ici le code nécessaire pour le chargement des données à partir du
         // fichier : [s.name()/].yaml, au niveau de la rubrique : "[o.name()/]"
         
         [protected (o.name().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
         [/protected]
         
         return [s.prefixAffectation()/]['service'.apply_attributeFinal()/].[o.name().apply_methodDefault()/]
            ([o.input->collect(o1 | o1.name())->sep(',')/]);
       }
       
    [/for]
  }
[/template]
 
[comment écriture de l'implémentation pour les tests du domaine./]
[template public serviceTestImpl (s : soa::Service)]
  [s.classHeader(s.namePackageServiceImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    import org.junit.jupiter.api.Test;
    import org.junit.jupiter.api.extension.ExtendWith;
    import static org.junit.jupiter.api.Assertions.*;
    import [s.namePackageProject()/].[s.namePackageCommonException()/].[s.nameClassNotImplementedExceptionImpl()/];
    import [s.namePackageProject()/].[s.namePackageCommonResolver()/].[s.nameClassServiceOutResolverImpl()/];
    
  [/protected]
  
  /**
   * Classe de test métier pour {@link [s.nameClassServiceImpl()/]}.
   * 
   * Cette classe contient des tests unitaires métier pour les méthodes du service
   * {@link [s.nameClassServiceImpl()/]}. Les tests sont exécutés avec l'extension 
   * {@link [s.nameClassServiceOutResolverImpl()/]} pour la gestion des paramètres.
   * 
   * @see [s.nameClassServiceImpl()/]
   * @see [s.nameClassServiceOutResolverImpl()/]
   */
  @ExtendWith([s.nameClassServiceOutResolverImpl()/].class)
  public class [s.nameClassServiceTestImpl()/]
  {
  
    [for (o | s.ownedInterface.ownedOperations)]
      @Test
      public void [o.name().apply_methodDefault()/](final [s.nameClassServiceImpl()/] [s.name().apply_parameterMethodClassicIn()/])
      {
        
        [protected (o.name().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
          
          throw new [s.nameClassNotImplementedExceptionImpl()/]
            ("Le test n'a pas été implémenté pour le service : [s.nameClassServiceImpl()/]");
          
        [/protected]
      }
    [/for]
    
    [protected (s.nameClassServiceTestImpl().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    [/protected]
  }
[/template]

[comment écriture de l'implémentation du résolveur de paramètres pour les tests junit (domain + infra)./]
[template public serviceOutResolverImpl(s : soa::Service)] 
  [s.classHeader(s.namePackageCommonResolver())/]
  
  import org.junit.jupiter.api.extension.ExtensionContext;
  import org.junit.jupiter.api.extension.ParameterContext;
  import org.junit.jupiter.api.extension.ParameterResolutionException;
  import org.junit.jupiter.api.extension.ParameterResolver;
  import [s.namePackageProject()/].[s.namePackageOutItf()/].[s.nameClassServiceOutItf()/];
  import [s.namePackageProject()/].[s.namePackageOutStubImpl()/].[s.nameClassServiceOutStubImpl()/];
  import [s.namePackageProject()/].[s.namePackageServiceImpl()/].[s.nameClassServiceImpl()/];
  
 /**
  * Cette classe implémente l'interface {@link ParameterResolver} et sert à
  * résoudre les paramètres dans le contexte d'un test, en fournissant une
  * instance de {@link [s.nameClassServiceImpl()/]}. Elle est utilisée pour
  * injecter une instance de {@link [s.nameClassServiceImpl()/]} dans les tests de
  * manière automatique.
  * 
  * La méthode {@link #supportsParameter(ParameterContext, ExtensionContext)}
  * vérifie si le paramètre peut être résolu par ce résolveur, et la méthode
  * {@link #resolveParameter(ParameterContext, ExtensionContext)} résout le
  * paramètre en créant une instance de {@link [s.nameClassServiceImpl()/]}.
  * <p>
  * Le resolveur permet d'injecter automatiquement le stub (au lieu de la couche
  * de persistance) dans l'instance de {@link [s.nameClassServiceImpl()/]}.
  * <p>
  * Cette classe est typiquement utilisée dans le cadre des tests unitaires avec
  * JUnit 5 et l'extension de test JUnit Jupiter.
  *
  * @Author [s.nameAuthor()/] 
  * 
  * @see ParameterResolver
  * @see [s.nameClassServiceImpl()/]
  * @see [s.nameClassServiceOutItf()/]
  * @see [s.nameClassServiceOutStubImpl()/]
  */
  public class [s.nameClassServiceOutResolverImpl()/] implements ParameterResolver 
  {
  
    /**
     * Vérifie si ce résolveur prend en charge le paramètre en question.
     * 
     * @param parameterContext le contexte du paramètre à vérifier
     * @param extensionContext le contexte de l'extension du test
     * @return true si ce résolveur prend en charge le paramètre, sinon false
     * @throws ParameterResolutionException si une erreur se produit lors de la
     *                                      résolution du paramètre
     */
    @Override
    public boolean supportsParameter(ParameterContext parameterContext, ExtensionContext extensionContext)
    		throws ParameterResolutionException {
    	return parameterContext.getParameter().getType() == [s.nameClassServiceImpl()/].class;
    }
    
    /**
    * Résout le paramètre en créant une instance de
    * {@link [s.nameClassServiceImpl()/]} avec un {@link [s.nameClassServiceOutItf()/]}.
    * Dans cet exemple, un stub de {@link [s.nameClassServiceOutItf()/]} est utilisé pour
    * les tests.
    * 
    * @param parameterContext le contexte du paramètre à résoudre
    * @param extensionContext le contexte de l'extension du test
    * @return une instance de {@link [s.nameClassServiceImpl()/]} prête à être
    *         utilisée dans le test
    * @throws ParameterResolutionException si une erreur se produit lors de la
    *                                      résolution du paramètre
    */
    @Override
    public Object resolveParameter(ParameterContext parameterContext, ExtensionContext extensionContext)
    		throws ParameterResolutionException {
    	[s.nameClassServiceOutItf()/] [s.suffixInterfaceOut().apply_variableDefault()/] = new [s.nameClassServiceOutStubImpl()/]();
    	return new [s.nameClassServiceImpl()/]([s.suffixInterfaceOut().apply_variableDefault()/]);
    }
  }
[/template]

[comment écriture du fichier de définition des données à injecter pour le service dans les tests fonctionnels (karate/domain) I*
         ci il n'y a aucune contrainte technique et c'est à l'utilisateur de voir à quelle profondeure il désire aller dans 
         l'éventuelle grappe. On peut donc renvoyer la globalité de la grappe./]
[template public serviceApiTestRunnerDefaultData (s : soa::Service, m : soa::System)]
  [for (o | s.ownedInterface.ownedOperations->select(o1 | o1.isRsOperation())) separator('\n')]
    [o.name()/]:
    
    
       [o.writeDataYaml(m)/]
       
       [protected (o.name().protectedId()) startTagPrefix('# ') endTagPrefix('# ')]
         
         [o.writeDataYaml(m)/]
         
        [/protected]
  [/for]
[/template]

[comment écriture de l'exemple de structure pour le fichier yaml./]
[query private writeDataYaml(o : soa::Operation, m : soa::System) : String = let out = o.output->first() in if (out.type.oclIsKindOf(environment::DTO)) then 
  out.type.oclAsType(environment::DTO).writeDtoYaml(m.subTypesDtos(), m.superTypesDtos(), out.isMultiple(), true, '', Sequence{out.type.oclAsType(environment::DTO)}) 
  else out.writeParamYaml() endif + if (o.hasInputs())  then m.lineSeparator() + '----- entrées -----' + m.lineSeparator() else '' endif + o.input
  ->collect(p | if (p.type.oclIsKindOf(environment::DTO)) then p.type.oclAsType(environment::DTO).writeDtoYaml(m.subTypesDtos(), m.superTypesDtos(), p.isMultiple()
  , false, '', Sequence{p.type.oclAsType(environment::DTO)}) else p.writeParamYaml() endif)/]

[comment écriture d'un dto (qu'il soit en entrée ou en sortie) avec récursivité pour les références. Evite la récursivité infinie 
         des références et transférant les dtos déjà visités./]
[query private writeDtoYaml(d : environment::DTO, ds : Sequence(environment::DTO), dss : Sequence(environment::DTO)
  , lst : Boolean, isOutput : Boolean, indent : String, visited : Sequence(environment::DTO)) : String = indent + (if (lst) then '- ' else '' endif)
  + if(isOutput) then d.writePk() else d.name() endif + ':' + d.lineSeparator() + d.attributesNoPK()->collect(a | indent + '  ' + a.name() 
  + ': ' + (if (a.type.needsYamlQuotes()) then '""' else '' endif) + d.lineSeparator()) + d.referencesFKSBResolved(ds,dss)->union(d.referencesJTSBResolved())
  ->select(r | not visited->includes(r.referencedDto(d)))->collect(r | indent + '  ' + if (r.isInverseReference(d)) then r.referencedDto(d).writePk() + ':' 
  + d.lineSeparator() else  r.referencedDto(d).referencedName(r) + ':' + d.lineSeparator() + r.referencedDto(d).writeDtoYaml(ds, dss, r.referencedTypeSignature(d)
  .matches('.*(List|Set).*'), false, indent + '    ', visited->including(r.referencedDto(d)) endif))/]

[comment écriture d'un simple paramètre qu'il soit en entrée ou en sortie./]
[query private writeParamYaml(p : soa::Parameter) : String = p.name() + ' : ' + if (p.type.needsYamlQuotes()) then '""' else '' endif + p.lineSeparator()/]
  
[comment vérifie si en fonction des champs on place des guillements./]
[query private needsYamlQuotes(t : environment::Type) : Boolean = Sequence{'string', 'date', 'time', 'timestamp'}->includes(t.name.toLower())/]

[comment écriture de la signature complète d'une opération avec le paramètre en sortie et les paramètres en entrée./]
[query private writeOperation(o : soa::Operation) : String = 'public ' + o.outputType() + ' ' + o.nameOperation() + '(' + o.inputSignature() + ')' /]

[comment écriture des différents paramètres à injecter pour l'opération (uri / cookie)/]
[query private writeRsInputHeaderParams(o : soa::Operation) : String = '.cookie(new Cookie("userId", input1))'/]