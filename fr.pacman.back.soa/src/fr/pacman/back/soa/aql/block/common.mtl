[module common(	'http://www.obeonetwork.org/dsl/soa/4.0.0', 
				'http://www.obeonetwork.org/dsl/entity/3.0.0', 
				'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]
[import fr::pacman::back::core::aql::query::reference/]
[import fr::pacman::back::core::aql::query::property/]
[import fr::pacman::back::core::aql::output::comments/]
[import fr::pacman::back::core::aql::name::eobjects/]
[import fr::pacman::back::core::aql::query::attribute/]
[import fr::pacman::back::core::aql::query::dto/]
[import fr::pacman::back::core::aql::rule::parameter/]
[import fr::pacman::back::core::aql::rule::method/]
[import fr::pacman::back::core::aql::rule::attribute/]


[comment écriture de toute la partie identifiant (avec les assesseurs)./]
[template public writeIdPropertyWithGetterAndSetter(d : environment::DTO, cmd : String)]
  [let e = d.associatedEntity()]
    /**
     * Retourne l'identifiant pour le dto. 
     *
     * @return la valeur de l'identifiant.
     */
     public [d.defaultTypePk()/] [d.getPkName().apply_methodGet()/]()
     {
       return [d.prefixAffectation()/][d.getPkName().apply_attributeDefault()/];
     } 
     
    /**
     * Affecte l'identifiant pour le dto. 
     *
     * @param la valeur de l'identifiant.
     */
     public void [d.getPkName().apply_methodSet()/] (final [d.defaultTypePk()/] [d.getPkName().apply_parameterMethodClassicIn()/])
     {
        [d.prefixAffectation()/][d.getPkName().apply_attributeDefault()/] = [d.getPkName().apply_parameterMethodClassicIn()/];
     }
   [/let]
[/template]

[comment écriture des assesseurs pour les attributs standards du dto | xto./]
[template public writeGetterAndSetterForAttributes (d : environment::DTO, as : OrderedSet(environment::Attribute))]
  [for (a : environment::Attribute | as)]
    [a.commentGet()/]
    public [a.type()/] [a.nameAttribute().apply_methodGet()/]()
    {
      return [a.prefixAffectation()/][a.nameAttribute()/];
    }
     
    [a.commentSet()/]
    public void [a.nameAttribute().apply_methodSet()/](final [a.type()/] [a.nameAttribute().apply_parameterMethodClassicIn()/]) 
    {
      [a.prefixAffectation()/][a.nameAttribute()/] = [a.nameAttribute().apply_parameterMethodClassicIn()/];
    }
     
  [/for]
[/template]

[comment ******************************************************************************************************************************************./]
[comment ne jamais utiliser les méthodes associatesEntity, etc... à partir de cette partie, on travaille sur les références avec un modèle anémique./]
[comment ******************************************************************************************************************************************./]

[comment écriture des assesseurs pour les références (liaisons avec les autres dtos | xtos)./]
[comment cette méthode est une factorisation mais cela oblige à passer trop de paramètres (à revoir ?).//]
[template public writeGetterAndSetterForReferences(d : environment::DTO, rs : OrderedSet(environment::Reference), cmd : String, refInverse : Boolean)]
  [for (r : environment::Reference | rs)]
    [comment écriture spéciale pour les assesseurs des références inverses, on crée des assesseurs avec listes (List<>)./]
    [if (refInverse)] 
      [r.containingDto().referencedName(r).commentGet()/]
      public [r.writeReferenceSignatureInverse(cmd)/] [r.containingDto().referencedName(r).apply_methodGet()/]()
      {
          return [r.prefixAffectation()/][r.containingDto().referencedName(r).apply_attributeDefault()/];
      }
       
      [r.containingDto().referencedName(r).commentSet()/]
      public void [r.containingDto().referencedName(r).apply_methodSet()/]
          (final [r.writeReferenceSignatureInverse(cmd)/] [r.containingDto().referencedName(r).apply_parameterMethodClassicIn()/])
      {
         [r.prefixAffectation()/][r.containingDto().referencedName(r).apply_attributeDefault()/] 
           = [r.containingDto().referencedName(r).apply_parameterMethodClassicIn()/];
      }
    [comment écriture pour tous les autres assesseurs./]
    [else]
      [comment si DTO rien de particulier./]
      [if (d.cmdDto().equalsIgnoreCase(cmd))]
        [r.referencedDto().commentGet()/]
        public [r.writeReferenceSignature(cmd)/] [r.referencedDto().referencedName(r).apply_methodGet()/]()
        {
           return [r.prefixAffectation()/][r.referencedDto().referencedName(r).apply_attributeDefault()/];
        }
        
        [r.referencedDto().commentSet()/]
        public void [r.referencedDto().referencedName(r).apply_methodSet()/]
        (final [r.writeReferenceSignature(cmd)/] [r.referencedDto().referencedName(r).apply_parameterMethodClassicIn()/])
        {
           [r.prefixAffectation()/][r.referencedDto().referencedName(r).apply_attributeDefault()/] 
              = [r.referencedDto().referencedName(r).apply_parameterMethodClassicIn()/];
        }
      [comment si XTO il faut traiter les références applaties (cas unidirectionnelle (0,*) et containingType)./]
      [else]
        [comment référence à aplatir dans tous les cas, quelle que soit la stratégie./]
        [comment (A->B (0,*) A List<B> et B prend A -> à applatir./]
        [if (r.hasToFlattenReference(d))]
          [r.referencedDto().writePkNameFlatten(r).commentGet()/]
          public [r.defaultTypeFk()/] [r.referencedDto().referencedName(r).apply_methodGet()/]()
          {
            return [r.prefixAffectation()/][r.referencedDto().writePkNameFlatten(r)/];
          }
          [r.referencedDto().writePkNameFlatten(r).commentSet()/]
          public void [r.referencedDto().referencedName(r).apply_methodSet()/]([r.defaultTypeFk()/] 
            [r.referencedDto().writePkNameFlatten(r).apply_parameterMethodClassicIn()/]){
            [r.prefixAffectation()/][r.referencedDto().writePkNameFlatten(r)/] 
              = [r.referencedDto().writePkNameFlatten(r).apply_parameterMethodClassicIn()/];
          }
        [comment on retourne sur le traitement courant./]
        [else]
          [r.referencedDto().commentGet()/]
          public [r.writeReferenceSignature(cmd)/] [r.referencedDto().referencedName(r).apply_methodGet()/]()
          {
             return [r.prefixAffectation()/][r.referencedDto().referencedName(r).apply_attributeDefault()/];
          }
          
          [r.referencedDto().commentSet()/]
          public void [r.referencedDto().referencedName(r).apply_methodSet()/]
          (final [r.writeReferenceSignature(cmd)/] [r.referencedDto().referencedName(r).apply_parameterMethodClassicIn()/])
          {
             [r.prefixAffectation()/][r.referencedDto().referencedName(r).apply_attributeDefault()/] 
                = [r.referencedDto().referencedName(r).apply_parameterMethodClassicIn()/];
          }
        [/if]
      [/if]
    [/if]

  [/for]
[/template]

[comment permet d'orienter vers les bonnes méthodes en fonction d'un dto ou d'un xto./]
[query private writeReferenceSignature(r : environment::Reference, cmd : String) : String = if (r.cmdDto().equalsIgnoreCase(cmd)) 
  then r.referencedSignature() else r.referencedSignatureOut() endif/]
  
[comment permet d'orienter vers les bonnes méthodes en fonction d'un dto ou d'un xto./]
[query private writeReferenceSignatureInverse(r : environment::Reference, cmd : String) : String = if (r.cmdDto().equalsIgnoreCase(cmd)) 
  then r.referencedSignatureInverse() else r.referencedSignatureOutInverse() endif/]

[comment raccourci pour l'écriture de la clé primaire./]
[query public getPkName(d : environment::DTO) : String = d.nameSimplePropertyID()/]
  
[comment écriture de la clé applatie dans le cadre des unidirectionnelles (0,n). (A->B) B prend la clé applatie de A./]
[query public writePkNameFlatten (d : environment::DTO, r : environment::Reference) : String =  d.referencedName(r).apply_attributeDefault()/]
