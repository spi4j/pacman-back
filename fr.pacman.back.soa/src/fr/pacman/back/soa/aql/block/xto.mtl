[module xto(	'http://www.obeonetwork.org/dsl/soa/4.0.0', 
				'http://www.obeonetwork.org/dsl/entity/3.0.0', 
				'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]	
[import fr::pacman::back::core::aql::name::classes/]
[import fr::pacman::back::core::aql::name::packages/]
[import fr::pacman::back::core::aql::name::eobjects/]
[import fr::pacman::back::core::aql::query::property/]
[import fr::pacman::back::core::aql::query::attribute/]
[import fr::pacman::back::core::aql::output::headers/]
[import fr::pacman::back::core::aql::output::comments/]
[import fr::pacman::back::core::aql::output::resources/]
[import fr::pacman::back::core::aql::query::eobject/]
[import fr::pacman::back::core::aql::query::reference/]
[import fr::pacman::back::core::aql::query::dto/]
[import fr::pacman::back::core::aql::rule::parameter/]
[import fr::pacman::back::core::aql::rule::attribute/]
[import fr::pacman::back::core::aql::rule::method/]
[import fr::pacman::back::soa::aql::block::common/]
[import fr::pacman::back::core::service::ReferenceUtils/]		

[comment écriture de l'implémentation pour un objet métier sérialisé (xto)./]
[template public xtoImpl(d : environment::DTO)]
  [d.classHeader(d.namePackageXtoImpl())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [d.defaultImports()/]
    import java.io.Serializable;
    import com.fasterxml.jackson.annotation.JsonProperty;
    import com.fasterxml.jackson.annotation.JsonIgnore;
    import io.swagger.v3.oas.annotations.media.Schema;
    import io.swagger.v3.oas.annotations.media.ArraySchema;
    import com.fasterxml.jackson.annotation.JsonManagedReference;
    import com.fasterxml.jackson.annotation.JsonBackReference;
    
  [/protected]
  
  [d.commentClass()/]
  [protected ('annotations'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
  [/protected]
  @Schema(description = "[d.writeDescriptionSingleLine()/]")
  public class [d.nameClassXtoImpl()/] implements Serializable
  {
     
     // CONSTANTES
     
     ['SerialUid'.commentMultiLines()/]
     private static final long serialVersionUID = -1;
     
     [protected ('constantes'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
     [/protected]
     
     ['Id'.commentSingleLine()/]
     @JsonProperty("id")
     @Schema(description = "Identifiant unique de l'entité", accessMode = Schema.AccessMode.READ_ONLY)
     private [d.defaultTypePk()/] [d.getPkName().apply_attributeDefault()/];
     
     // ATTRIBUTS
     
     [let oas = d.autoAttributes()]
     [let rbs = d.get_bidirectionnals()] 
     [let rus = d.get_unidirectionnals()]
     [let ris = d.get_unidirectionnalsInverse()]
       
       [for (a : environment::Attribute | d.attributesNoPKAndNoComputed())]
         [a.comment().commentSingleLine()/]
         [protected (a.nameAttribute().protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
           @JsonProperty("[a.nameAttribute()/]")
         [/protected]
         @Schema(description = "[a.writeDescriptionSingleLine()/]")
         private [a.type()/] [a.nameAttribute()/];
         
       [/for]
       
       [comment ecriture des références unidirectionnelles ici il faut traiter les références applaties./]
       [for (r : environment::Reference | rus)]
         [r.referencedDto().comment().commentSingleLine()/]
         [protected (r.referencedDto().referencedName(r).protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
           @JsonProperty("[r.referencedDto().referencedName(r).apply_attributeDefault()/]")
         [/protected]
         [comment note : référence à applatir dans tous les cas (A->B (0,*) A List<B> et B prend A -> à applatir)./]
         [if (r.isMultiple())]
           [r.writeShemaAnnotationFlatten(d)/]
           private [d.defaultTypeFk()/] [r.referencedDto().writePkNameFlatten(r)/];
         [else]
           [r.writeShemaAnnotation(d)/]
           private [r.referencedSignatureOut()/] [r.referencedDto().referencedName(r).apply_attributeDefault()/];
         [/if]
         
       [/for]
       
       [comment écriture des références bidirectionnelles./]
       [for (r : environment::Reference | rbs)]
         [r.referencedDto().comment().commentSingleLine()/]
         [protected (r.referencedDto().referencedName(r).protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
           @JsonProperty("[r.referencedDto().referencedName(r).apply_attributeDefault()/]")
         [/protected]
         [r.writeShemaAnnotation(d)/]
         private [r.referencedSignatureOut()/] [r.referencedDto().referencedName(r).apply_attributeDefault()/];
         
       [/for]
       
       [comment écriture des références inverses (A->B (0,*) A LIST<B>./]
       [for (r | d.get_unidirectionnalsInverse())]
         [r.referencedDto().comment().commentSingleLine()/]
         [protected (r.containingDto().referencedName(r).protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
           @JsonProperty("[r.containingDto().referencedName(r).apply_attributeDefault()/]")
         [/protected]
         [r.writeShemaAnnotationInverse(d)/]
         private [r.referencedSignatureOutInverse()/] [r.containingDto().referencedName(r).apply_attributeDefault()/];
         
       [/for]
               
       [('Constructeur sans paramètre pour la classe : ' + d.nameClassXtoImpl()).commentMultiLines()/]
       public [d.nameClassXtoImpl()/] ()
       {
         super();
       }
       
       [d.writeIdPropertyWithGetterAndSetter(d.cmdDto())/]
       [d.writeGetterAndSetterForAttributes(d.attributesNoPKAndNoComputed())/]
       
       [d.writeGetterAndSetterForReferences(rbs->union(rus), d.cmdXto(),false)/]
       [d.writeGetterAndSetterForReferences(ris, d.cmdXto(), true)/]
       
       // METHODES
       [protected ('methods'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
       [/protected]
       
     [/let][/let]
     [/let][/let]
  }
[/template]

[comment écriture de l'annotation @Schema pour open api (ancienne version)./]
[comment query private writeShemaAnnotation(r : environment::Reference, d : environment::DTO) : String = if (r.isMultiple() 
  and r.containedType(d) = d) then '@JsonManagedReference' + r.lineSeparator() + if (r.isMandatory()) then '@Schema(hidden = true)' 
  + ' //Non utile pour swagger-ui.' else '@ArraySchema(schema = @Schema(implementation = ' + r.referencedDto(d).nameClassXtoImpl() 
  + '.class))' endif else '@JsonBackReference' + r.lineSeparator() + '@Schema(implementation = ' + r.referencedDto(d).nameClassXtoImpl() 
  + '.class, description = "' + r.referencedDto(d).writeDescription() + '")'  endif/]

[comment écriture de l'annotation @Schema pour open api./]
[query private writeShemaAnnotationFlatten(r : environment::Reference, d : environment::DTO) : String = '@Schema(description = "Identifiant de ' 
  + r.referencedDto().writeDescriptionSingleLine() + '")'/]

[comment écriture de l'annotation @Schema pour open api./]  
[query private writeShemaAnnotation(r : environment::Reference, d : environment::DTO) : String =  
  if (r.isMultiple()) then'@ArraySchema(schema = @Schema(ref = "#/components/schemas/' + r.referencedDto().nameClassXtoImpl() + '"))'else'@Schema(ref = "' 
  + '#/components/schemas/' + r.referencedDto().nameClassXtoImpl() + '", description = "' + r.referencedDto().writeDescriptionSingleLine() + '")'endif /]
  
[comment écriture de l'annotation @Schema pour open api (ici se souvenir qu'on a inversé les acteurs c'est donc containing et non referenced)./]
[query private writeShemaAnnotationInverse(r : environment::Reference, d : environment::DTO) : String = '@ArraySchema(schema = @Schema(ref = "' +
   '#/components/schemas/' + r.containingDto().nameClassXtoImpl() + '"))'/]

