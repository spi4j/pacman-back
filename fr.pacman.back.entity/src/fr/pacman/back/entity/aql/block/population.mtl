[module population(	'http://www.obeonetwork.org/dsl/entity/3.0.0', 
					'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]
[import fr::pacman::back::core::aql::output::headers/]
[import fr::pacman::back::core::aql::name::packages/]
[import fr::pacman::back::core::aql::name::classes/]	
[import fr::pacman::back::core::aql::name::eobjects/]	
[import fr::pacman::back::core::aql::query::entity/]
[import fr::pacman::back::core::aql::query::attribute/]
[import fr::pacman::back::core::aql::query::reference/]
[import fr::pacman::back::core::aql::query::property/]
[import fr::pacman::back::core::aql::output::resources/]
[import fr::pacman::back::core::aql::output::comments/]
[import fr::pacman::back::core::aql::rule::attribute/]
[import fr::pacman::back::core::aql::rule::parameter/]
[import fr::pacman::back::core::aql::rule::variable/]
[import fr::pacman::back::core::aql::rule::method/]
[import fr::pacman::back::core::service::ReferenceUtils/]	

[comment écriture des commandes pour le peuplement de la base de données./]
[template public population (root : entity::Root, dbType : String)]
  [root.classHeader(root.namePackageInfrastructureBase())/]
  [protected ('imports'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
    
    [root.defaultImports()/]
    import org.springframework.stereotype.Component;
    import org.springframework.beans.factory.annotation.Autowired;
    import jakarta.annotation.PostConstruct;
    import java.util.stream.IntStream;
    import net.datafaker.Faker;
    import java.util.Locale;
    
  [/protected]
  
  /**
   * Composant chargé d'initialiser la base de données de l'application
   * avec des données de démonstration.  
   * <p>
   * Cette implémentation utilise <strong>DataFaker</strong> pour générer
   * des données textuelles aléatoires, et les API <strong>java.time</strong>
   * pour produire des dates, heures et timestamps modernes et non dépréciés.
   * </p>
   *
   * Au démarrage de l'application, la méthode {@link #populate()} est
   * automatiquement exécutée grâce à l'annotation {@code @PostConstruct},
   * ce qui entraîne la création des entités persistées en base via leurs 
   * repositories Spring Data.
   * </p>
   *
   * Les méthodes utilitaires {@code randomLocalDate()}, {@code randomTimeStamp()}
   * et {@code randomTime()} permettent de générer des valeurs temporelles
   * cohérentes et compatibles avec Java 17+ et DataFaker 2.5+.
   * </p>
   *
   * @author [root.nameAuthor()/]
   */
  @Component
  @SuppressWarnings("unused")
  public class [root.nameClassDatabasePopulateImpl()/] {
  
  [let es = root.subTypesEntities()]
    ['Gestionnaires de persistance disponibles'.commentSingleLine()/]
    [for (e : entity::Entity | es)]
      final [e.nameClassEntityPersistItf()/] [e.nameClassEntityPersistItf().apply_attributeDefault()/];
    [/for]
     
    ['Gestionnaires de données aléatoires'.commentSingleLine()/]
    private Faker ['faker'.apply_attributeDefault()/] = new Faker(Locale.FRANCE);
    
    ['Valeurs par défaut pour les dates et heures'.commentSingleLine()/]
    private LocalDate ['random local date'.apply_methodDefault()/](int ['days ahead'.apply_parameterMethodClassicIn()/]) {
        return LocalDate.now().plusDays(['faker'.apply_attributeDefault()/]
          .number().numberBetween(0, ['days ahead'.apply_parameterMethodClassicIn()/]));
    }
    
    ['Valeurs par défaut pour les dates et heures'.commentSingleLine()/]
    private Timestamp ['random time stamp'.apply_methodDefault()/](int ['days ahead'.apply_parameterMethodClassicIn()/]) {
        return Timestamp.from(Instant.now().plus(['faker'.apply_attributeDefault()/]
          .number().numberBetween(0, ['days ahead'.apply_parameterMethodClassicIn()/]), ChronoUnit.DAYS));
    }
    
    ['Valeurs par défaut pour les dates et heures'.commentSingleLine()/]
    private Time ['random time'.apply_methodDefault()/]() {
        return Time.valueOf(LocalTime.of(
                faker.number().numberBetween(0, 23),
                faker.number().numberBetween(0, 59),
                faker.number().numberBetween(0, 59)
        ));
    }
    
    ['Listes par défaut à utiliser pour les références'.commentSingleLine()/]
    [for (e : entity::Entity | es)]
      private List<[e.nameClassEntityImpl()/]> [(e.name() + ' list').apply_variableDefault()/] = new ArrayList<>();
    [/for]
    
    [protected ('configuration'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
      
      ['Nombre de lignes à créer dans la base de données'.commentSingleLine()/]
      private final int ['nb entities'.apply_attributeFinal()/] = 10;
      ['Nombre de lignes pour le stock dans lequel piocher les relations'.commentSingleLine()/]
      private final int ['nb default entities stock'.apply_attributeFinal()/] = 50;
      ['Nombre d\'entités à enregistrer pour chaque relation'.commentSingleLine()/]
      private final int ['nb relations'.apply_attributeFinal()/] = 5;
      
    [/protected]
    
    @Value("${spring.populate.faker.enabled:true}")
    private boolean populateEnabled;
    
    /**
     * Crée et stocke les entités nécessaires à l'initialisation de la base de données.
     * <p>
     * Les entités sont instanciées sans renseigner leurs relations afin d'éviter
     * toute récursivité lors de leur création. Les relations seront établies
     * ultérieurement à partir des entités stockées.
     * </p>
     */
    private void ['list entities populate'.apply_methodDefault()/](){
        IntStream.range(0, ['nb default entities stock'.apply_attributeFinal()/]).forEach(i -> {
        [for (e : entity::Entity | es)]
             [(e.name() + ' list').apply_variableDefault()/]
               .add([(e.name() +' populate').apply_methodDefault()/]());
        [/for]
      });
    }
    
    /**
     * Sélectionne aléatoirement une entité parmi celles disponibles.
     *
     * @param <T> type des entités
     * @param ['elements'.apply_parameterMethodClassicIn()/] collection des entités candidates
     * @return entité sélectionnée aléatoirement
     */
    private <T> T ['random element'.apply_methodDefault()/](List<T> ['elements'.apply_parameterMethodClassicIn()/]) {
        return ['faker'.apply_attributeDefault()/].options().nextElement(['elements'.apply_parameterMethodClassicIn()/]);
    }
    
    /**
     * Sélectionne aléatoirement un ensemble d'entités parmi celles disponibles.
     * <p>
     * Chaque sélection est indépendante : une même entité peut donc apparaître
     * plusieurs fois dans le résultat.
     * </p>
     *
     * @param <T> type des entités
     * @param ['elements'.apply_parameterMethodClassicIn()/] collection des entités candidates
     * @param ['count'.apply_parameterMethodClassicIn()/] nombre de sélections à effectuer
     * @return liste des entités sélectionnées aléatoirement
     */
    private <T> List<T> ['random elements'.apply_methodDefault()/](List<T> ['elements'.apply_parameterMethodClassicIn()/]
      , int ['count'.apply_parameterMethodClassicIn()/]) {
        return IntStream.range(0, ['count'.apply_parameterMethodClassicIn()/])
            .mapToObj(i -> randomElement(['elements'.apply_parameterMethodClassicIn()/]))
            .toList();
    }
    
    @Autowired
    ['Constructeur avec injection des persistance disponibles'.commentSingleLine()/]
    public [root.nameClassDatabasePopulateImpl()/]([es->writeConstructorSignature()/]) {
     
     [for (e : entity::Entity | es)]
       [e.prefixAffectation()/][e.nameClassEntityPersistItf().apply_attributeDefault()/] 
         = [e.nameClassEntityPersistItf().apply_parameterMethodClassicIn()/];
     [/for]
    }
    
    [for (e : entity::Entity | es)]
      [e.description.commentMultiLines()/]
      [e.nameClassEntityImpl()/] [(e.name() + ' populate').apply_methodDefault()/] () {
          
          [e.nameClassEntityImpl()/] [e.name().apply_variableDefault()/] = new [e.nameClassEntityImpl()/]();
          
          // Liste des attributs à recopier dans la zone réservée.
          
          [for (a | e.attributesNoPK())]
            // [e.name().apply_variableDefault()/].[a.name().apply_methodSet()/]([a.type.writeFakerData()/]);
          [/for]
          
          [let rus = e.get_unidirectionnals()]
          [let ris = e.get_unidirectionnalsInverse()]
          [let rbs = e.get_bidirectionnals()]
            [comment préférable de ne pas aller plus loin. Risque de boucle infinie avec la récursivité/]
            [for (r | rus)]
              // [r.writeFKPopulate(e)/]
            [/for]
            [for (r | ris)]
              // [r.writeFKInversePopulate(e)/]
            [/for]
            [for (r | rbs)]
              // [r.writeJTPopulate(e)/]
            [/for]
            
            [protected ((e.name() + ' populate').protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
            
            [for (a | e.attributesNoPK())]
              [e.name().apply_variableDefault()/].[a.name().apply_methodSet()/]([a.type.writeFakerData()/]);
            [/for]
              
            [/protected]
          
            return [e.name().apply_variableDefault()/];
          [/let]
          [/let]
          [/let]
      } 
    [/for] 
    
    /**
    * Initialise automatiquement la base de données avec un ensemble de
    * données de démonstration à chaque démarrage de l'application.
    * <p>
    * Cette méthode est exécutée automatiquement grâce à l'annotation
    * {@link PostConstruct}.  
    * Elle crée {@code ['nb entities'.apply_attributeFinalStatic()/]} entités dans la base.
    */
    @PostConstruct
    public void populate() {
      
      if (!populateEnabled) 
         return;
         
      // Initialisation des listes pour relations (0,*).
      ['list entities populate'.apply_methodDefault()/]();
      
      IntStream.range(0, [root.prefixAffectation()/]['nb entities'.apply_attributeFinal()/]).forEach(i -> {
      
        [comment cas des entités à ..../]
        [let res = es->primaryLoopEntities(root.superTypesEntities(),  root.eAllContents(environment::Reference) )]
          [for (e : entity::Entity | es)]
            // [e.writePopulateEntity(es)/]
          [/for]
          
          [protected ('populate'.protectedId()) startTagPrefix('// ') endTagPrefix('// ')]
            
            [for (e : entity::Entity | es)]
              [if (res->includes(e))]
                [e.writePopulateEntity(es)/]
              [/if]
            [/for]
            
          [/protected]
        [/let]
      });
    }
  [/let]
  }
[/template]

[comment écriture du nombre de lignes pour l'entité ./]
[query private writeNbRows(e : entity::Entity) : String = '10'/]
  
[comment récupération de la liste de toutes les entités qui n'ont aucune référence./]

[comment écriture de la ligne pour le peuplement de l'entité + sauvegarde./]
[query private writePopulateEntity(e : entity::Entity, es : Sequence(entity::Entity)) : String =
   e.nameClassEntityPersistItf().apply_attributeDefault() + '.save(' + (e.name() + ' populate').apply_methodDefault() + ' ' + '());'/]
  
[comment récupération de toutes les entités qui peuvent être instanciées dans la boucle primaire : toutes celles qui sont autonomes (pas de référence) 
         + toutes celles qui ont des références dont elles sont le point de départ - celles qui sont référencées par d'autres entités/]
[query private primaryLoopEntities(es : Sequence(entity::Entity), ess : Sequence(entity::Entity), rs : Sequence(environment::Reference)) : OrderedSet(entity::Entity) =
  es->collect(e | e.get_unidirectionnals()->collect(r | r.containingEntity().oclAsType(entity::Entity)))
  ->union( es->select(e | not rs->exists(r | r.containingType = e or r.referencedType = e)))->asSet()/]

[comment écriture de la signature pour le constructeur de la classe./]
[query private writeConstructorSignature (es : Sequence(entity::Entity)) : String = '' + es->collect(o | 'final ' 
  + o.nameClassEntityPersistItf() + ' ' + o.nameClassEntityPersistItf().apply_parameterMethodClassicIn())->sep(', ')/]
  
[comment écriture de la signature pour la méthode de population de l'entité (entités référencées)/]
[comment query private writePopulateSignature(e : entity::Entity, es : Sequence(entity::Entity), ess : Sequence(entity::Entity)) : String = '' 
  + e.get_unidirectionnals()->collect(o |'final ' + if (not o.isInverseReference(e) and o.isMultiple()) then 'List<' else '' endif 
  + o.referencedEntity().nameClassEntityImpl() + if (not o.isInverseReference(e) and o.isMultiple()) then '>' else '' endif + ' ' 
  + o.referencedEntity().name().apply_parameterMethodClassicIn())->sep(',')/]
  
[comment écriture de la signature pour la méthode de population de l'entité (entités référencées)/]
[comment query private writePopulateSignatureWithDefaultNull(e : entity::Entity, es : Sequence(entity::Entity), ess : Sequence(entity::Entity)) : String = 
  e.writePopulateSignature(es, ess).replaceAll('[^,]+','null')/]

[comment (REF) écriture d'une ligne pour le peuplement d'une référence  (A->B (1/(0,1)) A prend clé B) si (0,*) B prend clé A. ./]
[query private writeFKPopulate(r : environment::Reference , e : entity::Entity) : String = e.name().apply_variableDefault() + '.'  + r.referencedEntity()
  .referencedName(r).apply_methodSet() + '(' + 'random element'.apply_methodDefault() + '(' + (r.referencedEntity().name() + ' list').apply_attributeDefault() + '));'/]
  
[comment (REF) écriture d'une ligne pour le peuplement d'une référence  (A->B (1/(0,1)) A prend clé B) si (0,*) B prend clé A. ./]
[query private writeFKInversePopulate(r : environment::Reference , e : entity::Entity) : String = e.name().apply_variableDefault() + '.'  + r.containingEntity()
  .referencedName(r).apply_methodSet() + '(' + 'random elements'.apply_methodDefault() + '(' + (r.containingEntity().name() + ' list').apply_methodDefault() + ',' 
  + 'nb relations'.apply_attributeFinal() + '));'/]
  
[comment (REF) écriture d'une ligne pour le peuplement d'une référence  (A->B (1/(0,1)) A prend clé B) si (0,*) B prend clé A. ./]
[query private writeJTPopulate(r : environment::Reference , e : entity::Entity) : String = e.name().apply_variableDefault() + '.'  + r.referencedEntity()
  .referencedName(r).apply_methodSet()  + '(new HashSet<>(' + 'random elements'.apply_methodDefault() + '(' + (r.referencedEntity().name() 
  + ' list').apply_methodDefault() + ',' + 'nb relations'.apply_attributeFinal() + ')));'/]

[comment écriture des données aléatoires par défaut pour le peuplement de l'entité./]
[query private writeFakerData(t : environment::Type) : String = if ('Long'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() +'.number()' 
  else if ('Long'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.number().numberBetween(10L, 100L)' 
  else if ('Float'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.number().randomDouble(6, -500, 500)' 
  else if ('Integer'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.number().numberBetween(0, 100)' 
  else if ('Double'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.number().randomDouble(3, 1, 100)' 
  else if ('UUID'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.lorem().characters(5, 20)' 
  else if ('Boolean'.equalsIgnoreCase(t.name)) then 'faker'.apply_attributeDefault() + '.bool().bool()' 
  else if ('Date'.equalsIgnoreCase(t.name)) then 'random local date'.apply_methodDefault() + '(0)'
  else else if ('Time'.equalsIgnoreCase(t.name)) then 'random time'.apply_methodDefault() + '()'
  else else if ('Timestamp'.equalsIgnoreCase(t.name)) then 'random time stamp'.apply_methodDefault() + '(0)'
  else else if ('XXX'.equalsIgnoreCase(t.name)) then '.number()' 
  else 'faker'.apply_attributeDefault() + '.lorem().characters(5, 20)' endif  endif  endif  endif  endif   
  endif endif endif endif endif endif/]