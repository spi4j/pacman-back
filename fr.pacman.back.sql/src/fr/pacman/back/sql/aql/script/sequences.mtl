[module sequences(	'http://www.obeonetwork.org/dsl/entity/3.0.0', 
					'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]	
[import fr::pacman::back::core::aql::name::databases/]
[import fr::pacman::back::core::aql::query::database/]
[import fr::pacman::back::core::aql::query::entity/]
[import fr::pacman::back::sql::aql::script::headers/]

[import fr::pacman::back::core::service::DatabaseUtils/]

[comment création des séquences pour la base de données./]
[template public createSequences(root : entity::Root)]
  [root.sequencesHeader()/]
  [for (e : entity::Entity | root.subTypesEntities())]
    ['create sequence ' + e.nameSequence().toUpper() + ' start with ' + e.defaultSqlStartSequence() + ';'/]
  [/for]
[/template] 

[comment suppression des séquences pour la base de données./]
[template public dropSequences(root : entity::Root, dbType : String)]
  [root.sequencesHeader()/]
  [for (e : entity::Entity | root.subTypesEntities())]
    ['drop sequence ' + e.nameSequence().toUpper()/]
  [/for]
[/template]
