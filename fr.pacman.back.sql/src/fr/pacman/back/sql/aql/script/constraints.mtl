[module constraints(	'http://www.obeonetwork.org/dsl/entity/3.0.0', 
						'http://www.obeonetwork.org/dsl/environment/3.0.0')/]

[import fr::pacman::back::core::aql::base/]
[import fr::pacman::back::core::aql::string/]
[import fr::pacman::back::core::aql::name::eobjects/]
[import fr::pacman::back::core::aql::query::eobject/]
[import fr::pacman::back::core::aql::query::reference/]
[import fr::pacman::back::core::aql::name::databases/]
[import fr::pacman::back::core::aql::query::database/]
[import fr::pacman::back::core::aql::query::entity/]
[import fr::pacman::back::sql::aql::script::headers/]
[import fr::pacman::back::core::aql::rule::attribute/]

[import fr::pacman::back::core::service::AnnotationUtils/]
[import fr::pacman::back::core::service::DatabaseUtils/]
[import fr::pacman::back::core::service::ReferenceUtils/]

[comment création de l'ensemble des contraintes pour la base de données./]
[template public createConstraints(root : entity::Root, dbType : String)]
  [root.constraints(root.cmdCreate(),dbType)/]
[/template]

[comment suppression de l'ensemble des contraintes pour la base de données./]
[template public dropConstraints(root : entity::Root, dbType : String)]
  [root.constraints(root.cmdDelete(),dbType)/]
[/template]

[comment écriture des lignes pour les contraintes de la base de données./]
[template private constraints(root : entity::Root, cmd : String, dbType : String)]
  [root.constraintsHeader()/]
  [for (e : entity::Entity | root.subTypesEntities())]
    [for (a : environment::Attribute | e.attributes)]
      [if (a.has_metaPhysicalCheck())]
        [e.writeCheck(a, e.get_counterCK(), cmd)/];
      [/if]
      [if (a.type.oclIsKindOf(environment::Enumeration) 
        and not OrderedSet{a.type.oclAsType(environment::Enumeration)}->isEmpty())]
        [e.writeCheckEnum(a, e.get_counterCK(), cmd)/];
      [/if]
    [/for]
    [for (r | e.get_unidirectionnals())]
      [e.writeForeignKey(r, e.get_counterFK(1), cmd)/];
    [/for]
  [/for]
  [for (r | root.get_bidirectionnals())]
    [r .writeForeignKeyJoin1(cmd)/];
    [r.writeForeignKeyJoin2(cmd)/];
  [/for]
[/template]

[comment (REF) écriture de la ligne pour une contrainte sur les clés étrangères./]
[query private writeForeignKey(e : entity::Entity, r : environment::Reference, idx : Integer, cmd : String) : String = 'alter table ' 
	+ e.nameTableSchema().toUpper() +  if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' add' else ' drop' endif + ' constraint ' 
	+ e.nameConstraintForeignKey(r, idx).toUpper() + if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' foreign key (' + if (r.isZeroOneReflexive()) 
	then r.nameSimplePropertyID().toUpper() else  r.nameReferenceId(0).toUpper() endif + ') references ' + r.referencedEntity()
	.nameTableSchema().toUpper() + ' (' +  r.referencedEntity().namePrimaryKey().toUpper() + ')' else '' endif/]

[comment (REF) écriture de la ligne pour une contrainte sur les clé étrangères de jointure./]
[query private writeForeignKeyJoin1(r : environment::Reference, cmd : String) : String = 'alter table ' 
	+ r.nameTableSchemaJoin().toUpper() +  if (cmd.equalsIgnoreCase(r.cmdCreate())) then ' add' else ' drop' endif + ' constraint ' 
	+ r.nameConstraintJointure1().toUpper() + if (cmd.equalsIgnoreCase(r.cmdCreate())) then ' foreign key (' 
	+ r.containingEntity().namePrimaryKey().toUpper() + ') references ' + r.containingEntity().nameTableSchema().toUpper() + ' (' 
	+ r.containingEntity().namePrimaryKey().toUpper() + ')' else '' endif/]
	
[comment (REF) écriture de la ligne pour une contrainte sur les clé étrangères de jointure./]
[query private writeForeignKeyJoin2(r : environment::Reference, cmd : String) : String = 'alter table ' + r.nameTableSchemaJoin().toUpper() 
	+  if (cmd.equalsIgnoreCase(r.cmdCreate())) then ' add' else ' drop' endif + ' constraint ' + r.nameConstraintJointure2().toUpper() 
	+ if (cmd.equalsIgnoreCase(r.cmdCreate())) then ' foreign key (' + if (r.isReflexive()) then r.referencedEntity()
	.namePrimaryKey().insert(r.suffixSqlPrimaryKeyJoinReflexive(),r.suffixSqlId()).toUpper() else r.referencedEntity()
	.namePrimaryKey().toUpper() endif + ') references ' + r.referencedEntity().nameTableSchema().toUpper() + ' (' 
	+ r.referencedEntity().namePrimaryKey().toUpper() + ')' endif else '' endif/]

[comment écriture de la ligne pour la contrainte de vérification (check) sur un attribut./]
[query private writeCheck(e : entity::Entity, a : environment::Attribute, idx : Integer, cmd : String) : String = 'alter table ' 
	+  e.nameTableSchema().toUpper() +  if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' add' else ' drop' endif + ' constraint ' 
	+  e.nameConstraintCheck(idx).toUpper() + if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' CHECK (' + a.nameColumn().toUpper() 
	+ ' ' + a.get_metaPhysicalCheck() + ')' else '' endif/]

[comment écriture de la ligne pour la contrainte de vérification (check) sur un attribut de type énumération./]
[query private writeCheckEnum(e : entity::Entity, a : environment::Attribute, idx : Integer, cmd : String) : String = 'alter table ' 
	+ e.nameTableSchema().toUpper() +  if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' add' else ' drop' endif + ' constraint ' 
	+  e.nameConstraintCheck(idx).toUpper() + if (cmd.equalsIgnoreCase(e.cmdCreate())) then ' CHECK (' + a.nameColumn().toUpper() + ' IN ('
	+ a.type.oclAsType(environment::Enumeration).literals->asSequence()->collect(temp1 | temp1.enumStruct(a.type.oclAsType(environment::Enumeration)))
	->sep(',') + '))' else '' endif/]
	
[query private enumStruct(l : environment::Literal, e : environment::Enumeration) : String = '\'' 
	+  l.name.apply_attributeFinalStatic() + '\''/]	